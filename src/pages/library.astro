---
import Base from '../layouts/Base.astro';
import WorkRow from '../components/WorkRow.astro';
import { allWorks, allEras, allSubjects, eraOf, eraSpan, hosted, categoryOf, CATEGORIES } from '../lib/site';

const works = await allWorks();
const eras = await allEras();
const subjects = await allSubjects();
const subjectOrder = subjects.map((x) => x.id);
const counts = (fn: (w: any) => string | string[]) => {
  const m = new Map<string, number>();
  for (const w of works) for (const v of [fn(w)].flat()) m.set(v, (m.get(v) || 0) + 1);
  return m;
};
const groups = [
  { key: 'cat', label: 'Category', m: counts((w) => categoryOf(w.data.type)), labels: Object.fromEntries(CATEGORIES.map((c) => [c.id, c.label])), order: CATEGORIES.map((c) => c.id) },
  { key: 'type', label: 'Type', m: counts((w) => w.data.type) },
  { key: 'lang', label: 'Language', m: counts((w) => w.data.language) },
  { key: 'era', label: 'Era', m: counts((w) => eraOf(w.data.year, eras)?.id || 'none'), labels: { ...Object.fromEntries(eras.map((e) => [e.id, `${eraSpan(e.data)} · ${e.data.name}`])), none: 'Year unknown' } },
  { key: 'subjects', label: 'Subject', m: counts((w) => w.data.subjects.map((x: any) => x.id)), labels: Object.fromEntries(subjects.map((x) => [x.id, x.data.name])) },
  { key: 'access', label: 'Access', m: counts((w) => (hosted(w) ? 'hosted' : 'link')), labels: { hosted: 'Full text here', link: 'Link to free copy' } },
];
---
<Base title="Library" current="library">
  <link slot="head" href="/pagefind/pagefind-ui.css" rel="stylesheet">
  <div class="wrap page-top" style="padding-top:32px; display:flex; flex-direction:column; gap:24px">
    <h1 class="page-h1" style="font-size:40px">Library</h1>

    <div class="lib-controls" style="display:flex; flex-wrap:wrap; gap:10px">
      <label for="lq" class="sr-only">Filter the library</label>
      <input id="lq" type="search" data-suggest placeholder="Filter by title, author or subject" style="flex:1 1 420px; min-width:0; min-height:54px">
      <select id="sort" aria-label="Sort by" style="min-height:54px">
        <option value="random">Random order</option>
        <option value="az">Title A–Z</option>
        <option value="za">Title Z–A</option>
        <option value="author">Author (surname) A–Z</option>
        <option value="author-za">Author (surname) Z–A</option>
        <option value="old">Date: oldest first</option>
        <option value="new">Date: newest first</option>
      </select>
    </div>

    <details class="card" style="padding:16px 20px">
      <summary style="cursor:pointer; font-weight:600">Search inside the full texts</summary>
      <div id="fulltext" style="margin-top:14px"></div>
    </details>

    <div style="display:flex; flex-wrap:wrap; gap:28px; align-items:flex-start">
      <aside aria-label="Filters" class="card filters-panel" id="subjects" style="flex:1 1 250px; max-width:300px; padding:22px 22px 0">
        <details id="filters-details">
        <summary style="font-weight:600; cursor:pointer">Filters</summary>
        <div class="filters-body" style="display:flex; flex-direction:column; gap:22px; padding-bottom:22px">
        <button type="button" id="clear" style="align-self:flex-start; border:0; background:none; color:var(--green); font:inherit; font-size:14px; font-weight:500; padding:8px 0 0; cursor:pointer">Clear all</button>
        {groups.map((g) => (
          <fieldset style="border:0; margin:0; padding:0; display:flex; flex-direction:column; gap:6px">
            <legend style="font-size:13px; font-weight:600; letter-spacing:0.05em; color:var(--muted); margin-bottom:8px">{g.label.toUpperCase()}</legend>
            {[...g.m.entries()].sort((a, b) => (g as any).order ? (g as any).order.indexOf(a[0]) - (g as any).order.indexOf(b[0]) : g.key === 'era' ? eras.findIndex((e) => e.id === a[0]) - eras.findIndex((e) => e.id === b[0]) : g.key === 'subjects' ? subjectOrder.indexOf(a[0]) - subjectOrder.indexOf(b[0]) : b[1] - a[1]).map(([v, n]) => (
              <label style="display:flex; align-items:center; gap:10px; font-size:15px; min-height:32px; cursor:pointer">
                <input type="checkbox" data-filter={g.key} value={v}>
                <span style="flex:1">{(g as any).labels?.[v] ?? v}</span>
                <span class="muted" style="font-size:13px">{n}</span>
              </label>
            ))}
          </fieldset>
        ))}
        </div>
        </details>
      </aside>

      <section aria-label="Results" style="flex:999 1 560px; min-width:0; display:flex; flex-direction:column; gap:14px">
        <p class="muted" style="margin:0" role="status"><strong id="count" style="color:var(--ink)">{works.length}</strong> works match</p>
        <p id="near" class="near-note" hidden></p>
        <div id="qhits" class="card" hidden style="padding:16px 20px; font-size:15px">
          <strong style="font-size:13px; letter-spacing:0.05em; color:var(--muted)">ALSO IN THE QURAN SECTION</strong>
          <ul id="qhits-list" style="list-style:none; margin:8px 0 0; padding:0; display:flex; flex-direction:column; gap:6px"></ul>
        </div>
        <p id="none" class="card muted" hidden style="padding:40px; text-align:center; margin:0">No works match. Try fewer filters or a different word.</p>
        <div class="card" id="results">{works.map((w) => <WorkRow work={w} />)}</div>
        <button type="button" class="btn btn-outline load-more" id="more" hidden>Show more</button>
      </section>
    </div>
  </div>

  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    (function () {
      if (window.PagefindUI) new PagefindUI({ element: '#fulltext', showSubResults: true, showImages: false });
      var rows = Array.prototype.slice.call(document.querySelectorAll('[data-work]'));
      var box = document.getElementById('results');
      var q = document.getElementById('lq');
      var sort = document.getElementById('sort');
      var boxes = Array.prototype.slice.call(document.querySelectorAll('[data-filter]'));
      var params = new URLSearchParams(location.search);
      if (params.get('q')) q.value = params.get('q');
      ['subject', 'era', 'type', 'lang', 'cat'].forEach(function (k) {
        var v = params.get(k); if (!v) return;
        var key = k === 'subject' ? 'subjects' : k;
        boxes.forEach(function (b) { if (b.dataset.filter === key && b.value === v) b.checked = true; });
      });
      var PAGE = 50, limit = PAGE, reordered = false;
      var more = document.getElementById('more');
      more.addEventListener('click', function () { limit += PAGE * 2; apply(true); });
      function apply(keep) {
        if (keep !== true) limit = PAGE;
        var M = window.IAMatch;
        var term = M ? M.norm(q.value) : q.value.trim().toLowerCase();
        var qw = term ? term.split(' ') : [];
        var sel = {};
        boxes.forEach(function (b) { if (b.checked) (sel[b.dataset.filter] = sel[b.dataset.filter] || []).push(b.value); });
        var shown = 0;
        rows.forEach(function (r) {
          var ok = !term || qw.every(function (t) { return r.dataset.text.indexOf(t) !== -1; });
          for (var k in sel) {
            if (!ok) break;
            var have = k === 'subjects' ? r.dataset.subjects.split('|') : [r.dataset[k]];
            ok = sel[k].some(function (v) { return have.indexOf(v) !== -1; });
          }
          if (ok) shown++;
          r.hidden = !ok || shown > limit;
        });
        // nothing found: fall back to the nearest spellings and say so
        var near = document.getElementById('near');
        near.hidden = true;
        if (reordered && !(!shown && term)) { rows.forEach(function (r) { box.appendChild(r); }); reordered = false; }
        if (!shown && term && M) {
          var scored = [];
          rows.forEach(function (r) {
            var ok = true;
            for (var k in sel) { var have = k === 'subjects' ? r.dataset.subjects.split('|') : [r.dataset[k]]; if (!sel[k].some(function (v) { return have.indexOf(v) !== -1; })) { ok = false; break; } }
            if (!ok) return;
            r._w = r._w || r.dataset.text.split(' ');
            var sc = M.score(qw, r._w, true) || M.score(qw, r._w, false) / 4;
            if (sc >= 1) scored.push([sc, r]);
          });
          scored.sort(function (x, y) { return y[0] - x[0]; });
          // best matches first
          scored.forEach(function (x, i) { if (i < limit) x[1].hidden = false; box.appendChild(x[1]); });
          reordered = true;
          shown = scored.length;
          if (shown) { near.textContent = 'No exact match for “' + q.value.trim() + '”. Showing the nearest matches.'; near.hidden = false; }
        }
        // first visit, nothing chosen: a random list as long as the filter column
        if (sort.value === 'random' && !term && !Object.keys(sel).length && keep !== true) {
          var aside = document.getElementById('subjects');
          var target = aside.getBoundingClientRect().height - 60;
          var narrow = window.matchMedia && window.matchMedia('(max-width: 820px)').matches;
          if (narrow) target = 0;
          var start = box.getBoundingClientRect().top, n = 0;
          rows.forEach(function (r) { r.hidden = true; });
          var pool = rows;
          for (var i = 0; i < pool.length; i++) {
            pool[i].hidden = false; n++;
            if ((narrow && n >= 12) || (!narrow && box.getBoundingClientRect().bottom - start >= target && n >= 6)) break;
          }
          limit = n;
        }
        quranNote();
        more.hidden = shown <= limit;
        more.textContent = 'Show more (' + (shown - Math.min(shown, limit)) + ' left)';
        document.getElementById('count').textContent = shown;
        document.getElementById('none').hidden = shown !== 0;
        box.hidden = shown === 0;
      }
      var qtimer;
      function quranNote() {
        clearTimeout(qtimer);
        qtimer = setTimeout(function () {
          var box2 = document.getElementById('qhits'), list = document.getElementById('qhits-list');
          if (!window.IAMatch || !q.value.trim()) { box2.hidden = true; return; }
          window.IAMatch.quranHits(q.value, 8).then(function (hits) {
            list.innerHTML = '';
            hits.forEach(function (h) {
              var li = document.createElement('li'), a = document.createElement('a');
              a.href = h.url; a.textContent = h.name; li.appendChild(a);
              if (h.note) { var s2 = document.createElement('span'); s2.className = 'muted'; s2.style.fontSize = '13px'; s2.textContent = ' · ' + h.note; li.appendChild(s2); }
              list.appendChild(li);
            });
            box2.hidden = !hits.length;
          });
        }, 150);
      }
      // sort key: no accents or ʿayn/hamza marks, no leading quotes
      function key(t) { return (t || '').normalize('NFD').replace(/[\u0300-\u036f\u02bc-\u02bf\u2018-\u201f'"]/g, '').replace(/^[^a-z0-9\u0600-\uffff]+/i, ''); }
      var randomRows = rows.slice();
      for (var i = randomRows.length - 1; i > 0; i--) { var j = Math.floor(Math.random() * (i + 1)); var t = randomRows[i]; randomRows[i] = randomRows[j]; randomRows[j] = t; }
      var userSorted = false;
      function order() {
        var m = sort.value;
        if (m === 'random') { rows = randomRows.slice(); rows.forEach(function (r) { box.appendChild(r); }); apply(); return; }
        rows.sort(function (a, b) {
          if (m === 'az') return key(a.dataset.title).localeCompare(key(b.dataset.title));
          if (m === 'za') return key(b.dataset.title).localeCompare(key(a.dataset.title));
          if (m === 'author' || m === 'author-za') {
            var c = key(a.dataset.authorSort).localeCompare(key(b.dataset.authorSort)) || key(a.dataset.title).localeCompare(key(b.dataset.title));
            return m === 'author' ? c : -c;
          }
          var ya = a.dataset.year === '' ? null : +a.dataset.year, yb = b.dataset.year === '' ? null : +b.dataset.year;
          if (ya === null && yb === null) return a.dataset.title.localeCompare(b.dataset.title);
          if (ya === null) return 1; if (yb === null) return -1;
          return m === 'new' ? yb - ya : ya - yb;
        }).forEach(function (r) { box.appendChild(r); });
        apply();
      }
      // Random until the reader searches or filters; then an ordered list (title A–Z unless they chose an order).
      // Clearing everything goes back to the random list, unless they picked an order themselves.
      function active() { return q.value.trim() !== '' || boxes.some(function (b) { return b.checked; }); }
      function changed() {
        if (!userSorted) {
          var want = active() ? 'az' : 'random';
          if (sort.value !== want) { sort.value = want; order(); return; }
        }
        apply();
      }
      q.addEventListener('input', changed);
      sort.addEventListener('change', function () { userSorted = sort.value !== 'random'; order(); });
      boxes.forEach(function (b) { b.addEventListener('change', changed); });
      document.getElementById('clear').addEventListener('click', function () { boxes.forEach(function (b) { b.checked = false; }); q.value = ''; changed(); });
      sort.value = active() ? 'az' : 'random';
      order();
      window.addEventListener('resize', function () { if (sort.value === 'random' && !active() && limit <= PAGE) apply(); });
    })();
  </script>
</Base>
