---
import { getEntry, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import SendDialog from '../../../components/SendDialog.astro';
import { longDate } from '../../../lib/quran';
import { creative, breadcrumbs } from '../../../lib/schema';
import { categoryOf, allWorks, provenance, FORMATS, hosted, RIGHTS_LABEL, eraOf, eraSpan, allEras, subjectNames, chaptersOf, type Work } from '../../../lib/site';

export async function getStaticPaths() {
  // link-only entries have no page of their own: they are listed on author, subject and library pages with their own Cite button
  const works = (await allWorks()).filter((w) => w.data.rights !== 'link-only');
  return works.map((w) => ({ params: { slug: w.id }, props: { work: w } }));
}
const { work } = Astro.props as { work: Work };
const d = work.data;
const author = await getEntry(d.author);
const isHosted = hosted(work);
const { Content, headings } = await render(work);
const chapters = d.reader ? await chaptersOf(work.id) : [];
const toc = d.contents.length ? d.contents : headings.filter((h) => h.depth === 2 && h.slug !== 'footnote-label' && h.text !== 'Footnotes').map((h) => h.text);
const url = new URL(`/works/${work.id}/`, Astro.site).href;
const lastFirst = author ? (() => { const p = (d.byline || author.data.name).split(' '); return p.length > 1 ? `${p[p.length - 1]}, ${p.slice(0, -1).join(' ')}` : author.data.name; })() : '';
const prov = provenance(work);
const cite = `${lastFirst}. ${d.title}.${d.year ? ' ' + d.year + '.' : ''}${prov.archived ? ' Archived ' + longDate(prov.archived) + ' in' : ''} Islamic Internet Archives: Archive of Modern Islamic Thought. ${url}`;
const ld = author ? [
  creative(categoryOf(d.type) === 'books' ? 'Book' : 'Article', { title: d.title, url: `/works/${work.id}/`, authorName: d.byline || author.data.name, authorUrl: `/authors/${author.id}/`, year: d.year, language: d.language, summary: d.summary, source: d.sourceUrl }),
  breadcrumbs([{ name: 'Library', href: '/library/' }, { name: author.data.name, href: `/authors/${author.id}/` }, { name: d.title }]),
] : undefined;
const eras = await allEras();
const era = eraOf(d.year, eras);
const names = await subjectNames();
const subj = d.subjects.map((s) => ({ id: s.id, name: names.get(s.id) || s.id }));
---
<Base title={d.title} description={d.summary} jsonld={ld}>
  <div class="wrap" style="padding-top:24px; display:flex; flex-direction:column; gap:28px" data-pagefind-body>
    <nav data-pagefind-ignore aria-label="Breadcrumb" class="muted" style="font-size:14px; display:flex; flex-wrap:wrap; gap:8px">
      <a href="/library/">Library</a><span aria-hidden="true">/</span>
      {author && <><a href={`/authors/${author.id}/`}>{author.data.name}</a><span aria-hidden="true">/</span></>}
      <span>{d.title}</span>
    </nav>

    <div style="display:flex; flex-wrap:wrap; gap:40px; align-items:flex-start">
      <div class="work-meta-col" style="flex:1 1 260px; max-width:320px; display:flex; flex-direction:column; gap:18px">
        <div class="work-cover" style="aspect-ratio:2/3; background:var(--green-dark); border-radius:4px 10px 10px 4px; padding:28px 24px; display:flex; flex-direction:column; justify-content:space-between; color:#fff; border-left:10px solid #0E2E27">
          <span style="font-size:12px; letter-spacing:0.12em; color:#E9C78D">ISLAMIC ARCHIVES</span>
          <span style="font-family:var(--serif); font-weight:700; font-size:clamp(20px, 2.2vw, 28px); line-height:1.15">{d.title}</span>
          <span style="display:flex; flex-direction:column; gap:10px"><span style="height:2px; width:60px; background:var(--saffron)"></span><span>{d.byline || author?.data.name}</span></span>
        </div>
        <dl class="card" style="margin:0; display:grid; grid-template-columns:auto 1fr; gap:8px 16px; font-size:14px; padding:18px">
          {d.year && <><dt class="muted">Published</dt><dd style="margin:0">{d.year}</dd></>}
          {d.venue && <><dt class="muted">Venue</dt><dd style="margin:0">{d.venue}</dd></>}
          <dt class="muted">Language</dt><dd style="margin:0">{d.language}</dd>
          <dt class="muted">Type</dt><dd style="margin:0">{d.type}</dd>
          {d.sourceEdition && <><dt class="muted">Source</dt><dd style="margin:0">{d.sourceEdition}</dd></>}
          <dt class="muted">Rights</dt><dd style="margin:0"><span style="font-weight:600; color:var(--green)">{RIGHTS_LABEL[d.rights]}</span>{d.rightsNote && <span class="muted"> · {d.rightsNote}</span>}</dd>
        </dl>
      </div>

      <div style="flex:999 1 560px; min-width:0; display:flex; flex-direction:column; gap:24px">
        <div style="display:flex; flex-direction:column; gap:10px">
          <div style="display:flex; flex-wrap:wrap; gap:6px 14px; font-size:13px; font-weight:600; letter-spacing:0.05em">
            {subj.map((x) => <a href={`/subjects/${x.id}/`} data-pagefind-filter="subject" style="color:var(--saffron-text); text-decoration:none">{x.name.toUpperCase()}</a>)}
            {era && <a href={`/library/?era=${era.id}`} style="color:var(--muted); text-decoration:none">{eraSpan(era.data)}</a>}
          </div>
          <h1 style="font-size:clamp(30px, 3.6vw, 46px); line-height:1.1" data-pagefind-meta="title">{d.title}</h1>
          {d.titleOriginal && <p dir="auto" class="orig-title" style="margin:0; font-size:24px">{d.titleOriginal}</p>}
          {author && <a href={`/authors/${author.id}/`} style="font-size:18px; font-weight:500">{d.byline ? `${d.byline} (${author.data.name})` : author.data.name}{d.coAuthors ? ` with ${d.coAuthors}` : ''}</a>}
          {d.summary && <p style="margin:6px 0 0; font-size:17px; line-height:1.6; color:var(--ink-2); max-width:720px">{d.summary}</p>}
          {d.keywords.length > 0 && <p class="muted" style="margin:0; font-size:14px">Keywords: {d.keywords.map((k, i) => <>{i > 0 && ', '}<a href={`/library/?q=${encodeURIComponent(k)}`}>{k}</a></>)}</p>}
          <p class="muted" style="margin:0; font-size:13px; overflow-wrap:anywhere">{prov.archived ? `Archived ${longDate(prov.archived)}` : 'Archive date not recorded'} · Source: {prov.href ? <a href={prov.href} rel="noopener" target="_blank">{prov.label}</a> : (prov.label || 'not yet recorded')}</p>
        </div>

        {chapters.length > 0 && (
          <section aria-labelledby="toc-h" style="display:flex; flex-direction:column; gap:12px">
            <div style="display:flex; flex-wrap:wrap; justify-content:space-between; align-items:center; gap:12px">
              <h2 id="toc-h" style="font-size:24px">Contents</h2>
              <a class="btn btn-primary" href={`/works/${work.id}/${chapters[0].data.slug}/`}>Start reading</a>
            </div>
            <ol class="card reader-toc">
              {chapters.map((c, i) => (
                <li>
                  <a class="rt-row" href={`/works/${work.id}/${c.data.slug}/`}>
                    <span class="rt-n">{i + 1}</span>
                    <span class="rt-t">{c.data.title}</span>
                    {c.data.pages && <span class="rt-p muted">pp. {c.data.pages}</span>}
                  </a>
                  {c.data.sections.length > 0 && (
                    <ul class="rt-sub">
                      {c.data.sections.map((x) => <li><a href={`/works/${work.id}/${c.data.slug}/#${x.id}`}>{x.title}</a></li>)}
                    </ul>
                  )}
                </li>
              ))}
            </ol>
            {d.sourceUrl && <p class="muted" style="margin:0; font-size:14px">Page numbers in the text are those of the printed {d.sourceEdition ? 'edition' : 'book'}; each one links to that page of the scan{d.sourceLabel ? ` at ${d.sourceLabel.split(',')[0]}` : ''}.</p>}
          </section>
        )}

        <section data-pagefind-ignore class="card" aria-labelledby="dl-h" style="padding:24px; display:flex; flex-direction:column; gap:18px">
          {isHosted ? (
            <>
              <div style="display:flex; flex-wrap:wrap; justify-content:space-between; align-items:center; gap:12px">
                <h2 id="dl-h" style="font-size:24px">Read or download</h2>
                {chapters.length > 0 ? <a href={`/works/${work.id}/${chapters[0].data.slug}/`} style="font-weight:600; padding:10px 0">Read online →</a> : <a href="#text" style="font-weight:600; padding:10px 0">Read online ↓</a>}
              </div>
              {d.rights !== 'archival' && <div class="grid-auto" style="--min:200px; gap:10px">
                {FORMATS.map((f) => (
                  <a href={`/downloads/${work.id}.${f.ext}`} download style="text-decoration:none; color:var(--ink); border:1px solid var(--line); border-radius:8px; padding:12px 14px; display:flex; align-items:center; gap:12px">
                    <span style="width:44px; height:44px; flex:none; border-radius:6px; background:var(--green-tint); color:var(--green); display:flex; align-items:center; justify-content:center; font-size:11px; font-weight:700">{f.ext.toUpperCase()}</span>
                    <span style="display:flex; flex-direction:column"><span style="font-weight:600">{f.label}</span><span class="muted" style="font-size:13px">{f.note}</span></span>
                  </a>
                ))}
              </div>}
              <div style="display:flex; flex-wrap:wrap; gap:10px; border-top:1px solid var(--line-2); padding-top:18px">
                {d.rights !== 'archival' && <button type="button" class="btn btn-primary" data-send="kindle" data-slug={work.id} data-title={d.title}>Send to Kindle</button>}
                {d.rights !== 'archival' && <button type="button" class="btn btn-outline" data-send="email" data-slug={work.id} data-title={d.title}>Email it to me</button>}
                {d.sourceUrl && <a class="btn btn-quiet" href={d.sourceUrl} rel="noopener" target="_blank">Read at source ↗</a>}
              </div>
              {d.sourceUrl && d.sourceLabel && <p class="muted" style="margin:0; font-size:14px">Source: {d.sourceLabel}</p>}
              {d.sourceNote && <p class="muted" style="margin:0; font-size:14px">{d.sourceNote}</p>}
            </>
          ) : (
            <>
              <h2 id="dl-h" style="font-size:24px">{d.type === 'Video' ? 'Where to watch it' : 'Where to read it'}</h2>
              <p class="muted" style="margin:0">{d.type === 'Video' ? 'This is a recorded lecture or series. The archive links to where it can be watched free of charge.' : d.rights === 'link-only' ? (d.sourceUrl ? 'This work is still in copyright. A free copy is available elsewhere, so the archive links to it.' : 'This work is still in copyright, and no free copy has been found online yet.') : (d.sourceUrl ? 'The text of this work is being prepared for the archive. Meanwhile you can read it at the source below.' : 'The text of this work is being prepared for the archive.')}</p>
              {d.sourceUrl && <a class="btn btn-primary" href={d.sourceUrl} rel="noopener" target="_blank" style="align-self:flex-start">{d.type === 'Video' ? 'Watch ↗' : 'Read at source ↗'}</a>}
              {d.sourceUrl && <p class="muted" style="margin:0; font-size:14px; overflow-wrap:anywhere">Source: {d.sourceLabel || new URL(d.sourceUrl).hostname.replace(/^www\./, '')}</p>}
              {!d.sourceUrl && d.infoUrl && <a class="btn btn-outline" href={d.infoUrl} rel="noopener" target="_blank" style="align-self:flex-start">About this book ↗</a>}
              {d.sourceNote && <p class="muted" style="margin:0; font-size:14px; overflow-wrap:anywhere">{d.sourceNote}</p>}
            </>
          )}
        </section>

        {toc.length > 0 && chapters.length === 0 && (
          <section aria-labelledby="toc-h" style="display:flex; flex-direction:column; gap:12px">
            <h2 id="toc-h" style="font-size:24px">Contents</h2>
            <ol class="card" style="margin:0; padding:0; list-style:none">
              {toc.map((t, i) => (
                <li style="display:flex; gap:16px; align-items:baseline; padding:13px 20px; border-bottom:1px solid var(--line-2)">
                  <span style="font-family:var(--serif); font-weight:700; color:var(--saffron); width:22px">{i + 1}</span><span>{t}</span>
                </li>
              ))}
            </ol>
          </section>
        )}

        <section data-pagefind-ignore class="card" aria-labelledby="cite-h" style="padding:20px; display:flex; flex-direction:column; gap:10px">
          <div style="display:flex; justify-content:space-between; align-items:center; gap:10px">
            <h2 id="cite-h" style="font-family:var(--sans); font-size:16px">Cite this page</h2>
            <button type="button" class="btn btn-quiet" data-copy={cite}>Copy</button>
          </div>
          <p style="margin:0; font-size:14px; line-height:1.6; color:var(--ink-2)">{cite}</p>
        </section>
      </div>
    </div>

    {isHosted && chapters.length === 0 && (
      <article id="text" class="card" style="padding: clamp(24px, 5vw, 64px)">
        <div class="prose"><Content /></div>
      </article>
    )}
  </div>
  {isHosted && <SendDialog />}
  <script is:inline>
    document.querySelectorAll('[data-copy]').forEach(function (b) {
      b.addEventListener('click', function () {
        navigator.clipboard && navigator.clipboard.writeText(b.dataset.copy).then(function () { b.textContent = 'Copied'; });
      });
    });
  </script>
</Base>
