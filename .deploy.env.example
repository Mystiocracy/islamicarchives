# Copy this file to .deploy.env and fill it in. .deploy.env is never committed.
# hPanel -> Files -> FTP Accounts shows host, username and lets you set a password.
FTP_HOST=ftp.islamicarchives.org
FTP_USER=u701467048.islamicarchives.org
FTP_PASS=
# Folder the FTP login opens into that holds index.html. Often "." (the account is already inside
# public_html) or "domains/islamicarchives.org/public_html".
FTP_DIR=.
# true = FTP over TLS (try this first); set false only if the connection is refused.
FTP_SECURE=true
