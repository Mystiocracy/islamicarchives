---
import Base from '../../../../layouts/Base.astro';
import QuranSubnav from '../../../../components/QuranSubnav.astro';
import items from '../../../../data/manuscripts.json';
import { longDate } from '../../../../lib/quran';

const MIN = 560, MAX = 1000;
// Century bands (CE approximations of Hijri centuries)
const bands = [
  { l: '1st c. AH', a: 622, b: 719 }, { l: '2nd c. AH', a: 719, b: 815 },
  { l: '3rd c. AH', a: 815, b: 912 }, { l: '4th c. AH', a: 912, b: 1009 },
];
// Date ranges (CE) where the source gives an explicit one. Others fall back to the stated century band.
const explicit: Record<string, [number, number, string]> = {
  'sanaa-palimpsest-dam-01-27-1': [640, 660, 'Lower text c. mid-7th century CE'],
  'sanaa-qur-an-fragments-great-mosque-cache': [600, 1000, '7th–10th century CE (whole cache)'],
  'birmingham-qur-an-fragment-ms-mingana-islamic-arabic-1572a': [568, 645, 'Radiocarbon 568–645 CE (95%)'],
  'mingana-qur-anic-manuscripts-and-electronic-edition': [600, 900, '7th–9th century CE'],
  'topkapi-qur-an-h-s-32': [740, 760, 'Mid-8th century CE (others: late 7th–early 8th)'],
  'samarkand-kufic-qur-an-tashkent-uthman-qur-an': [775, 995, 'Radiocarbon 775–995 CE'],
  'samarkand-kufic-qur-an-folio-aga-khan-museum': [700, 900, '8th–9th century CE'],
  'codex-parisino-petropolitanus-bnf-arabe-328a-st-petersburg': [675, 725, 'Late 7th–early 8th century CE'],
  'british-library-or-2165': [700, 800, '8th century CE'],
  'chester-beatty-codex-is-1615-i': [591, 643, 'Radiocarbon 591–643 CE'],
  'walters-ms-w-553-qur-an-fragment': [800, 900, 'Probably 3rd century AH / 9th century CE'],
};
const periodRange: Record<string, [number, number]> = {
  '1st century AH': [622, 719], '1st–2nd century AH': [622, 815], '2nd century AH': [719, 815], '2nd–3rd century AH': [719, 912],
};
const short = (n: string) => n.split(' – ')[0].split(': ')[0].replace(/^The “(.+?)”\s*/, '“$1” ');
const rows = (items as any[]).filter((x) => x.kind === 'Manuscript').map((x) => {
  const ex = explicit[x.id];
  const r = ex ? [ex[0], ex[1]] : periodRange[x.period];
  if (!r) return null;
  return { id: x.id, name: short(x.name), full: x.name, a: r[0], b: r[1], basis: ex ? 'explicit' : 'band', note: ex ? ex[2] : x.period + ' (as dated by the site)', place: x.institution || x.location || '' };
}).filter(Boolean).sort((p: any, q: any) => p.a - q.a || p.b - q.b) as any[];
const pct = (y: number) => ((Math.min(Math.max(y, MIN), MAX) - MIN) / (MAX - MIN)) * 100;
const ticks = [600, 650, 700, 750, 800, 850, 900, 950];
const nExp = rows.filter((r) => r.basis === 'explicit').length;
const archived = longDate((items as any[])[0].archived);
---
<Base title="Quranic manuscript timeline" description="A visual timeline of early Qur'an manuscripts, plotted by the date range each source gives." current="quran">
  <div class="wrap" style="padding-top:40px; padding-bottom:48px" data-pagefind-body>
    <QuranSubnav current="timeline" />
    <h1 style="font-size:40px; margin:0 0 0.4em" data-pagefind-meta="title">Quranic manuscript timeline</h1>
    <div class="prose" style="font-family:var(--sans); font-size:17px; max-width:760px; margin-bottom:20px">
      <p>Each bar is the date range a source gives for a manuscript, on a common axis from 560 to 1000 CE (the first four Hijri centuries). <strong>{nExp}</strong> entries carry a range from the holder, a radiocarbon result or a named scholar. The other <strong>{rows.length - nExp}</strong> are placed only by the century that Islamic Awareness gives, so their bars are wide and approximate. Hijri centuries are converted to CE roughly. Dates are contested; the label and the catalogue entry say whose date it is. Recorded {archived}.</p>
    </div>
    <div class="legend"><span><i class="sw ex"></i>Range given by holder, radiocarbon or scholar</span><span><i class="sw bd"></i>Century only, as stated by Islamic Awareness</span><span><i class="sw an"></i>Traditional date (not manuscript evidence)</span></div>
    <div class="tl" role="figure" aria-label="Timeline of Qur'an manuscripts">
      <div class="hd">
        <div class="lab"></div>
        <div class="ch">
          {bands.map((b) => <div class="bandh" style={`left:${pct(b.a)}%;width:${pct(b.b) - pct(b.a)}%`}>{b.l}</div>)}
        </div>
      </div>
      <div class="hd ax">
        <div class="lab">CE</div>
        <div class="ch">{ticks.map((t) => <span class="tk" style={`left:${pct(t)}%`}>{t}</span>)}</div>
      </div>
      <div class="row anch"><div class="lab">Death of the Prophet; traditional codification under ʿUthmān</div>
        <div class="ch">{ticks.map((t) => <span class="vl" style={`left:${pct(t)}%`}></span>)}<span class="mk" style={`left:${pct(632)}%`} title="632 CE"></span><span class="mk" style={`left:${pct(650)}%`} title="c. 650 CE"></span><span class="mkl" style={`left:${pct(650) + 1}%`}>632 · c. 650 CE</span></div></div>
      {rows.map((r) => (
        <div class="row">
          <div class="lab"><a href={`/quran/manuscripts/#${r.id}`} title={r.full}>{r.name}</a></div>
          <div class="ch">{ticks.map((t) => <span class="vl" style={`left:${pct(t)}%`}></span>)}
            <a class={`bar ${r.basis}`} href={`/quran/manuscripts/#${r.id}`} style={`left:${pct(r.a)}%;width:${Math.max(pct(r.b) - pct(r.a), 0.6)}%`} title={`${r.full} — ${r.note}`}><span class="sr">{r.note}</span></a>
            <span class={`note${pct(r.b) > 68 ? " in" : ""} ${r.basis}`} style={pct(r.b) > 68 ? `right:${100 - pct(r.b) + 0.8}%` : `left:${pct(r.b) + 0.8}%`}>{r.note}</span>
          </div>
        </div>
      ))}
    </div>
    <p class="near-note" style="margin-top:16px; font-family:var(--sans); font-size:15px">Click a bar or name to open its catalogue entry. Collections, databases and studies are not plotted. See the <a href="/quran/manuscripts/">full catalogue</a>.</p>
  </div>
</Base>
<style>
  .legend { display:flex; gap:20px; flex-wrap:wrap; font:14px var(--sans); color:var(--muted); margin-bottom:12px }
  .sw { display:inline-block; width:22px; height:10px; border-radius:2px; margin-right:7px; vertical-align:middle }
  .sw.ex, .bar.explicit { background: var(--green) } .sw.bd, .bar.band { background: var(--saffron-tint); border:1px solid var(--saffron) } .sw.an { background: var(--ink); width:3px; height:14px }
  .tl { overflow-x:auto; border:1px solid var(--line); border-radius:10px; background:var(--surface); font-family:var(--sans); }
  .tl > * { min-width: 900px }
  .row, .hd { display:grid; grid-template-columns: 250px 1fr; align-items:center; }
  .row { border-top:1px solid var(--line); min-height:24px }
  .lab { padding:2px 10px; font-size:13px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; color:var(--ink-2) }
  .lab a { color:inherit; text-decoration:none } .lab a:hover { color:var(--green); text-decoration:underline }
  .ch { position:relative; height:24px }
  .vl { position:absolute; top:0; bottom:0; width:1px; background:var(--line) }
  .note.in { z-index:1; color:var(--ink) } .note.in.explicit { color:#fff }
  .xx { background-image: linear-gradient(to right, var(--line) 1px, transparent 1px); background-size: 11.3636% 100%; background-position: 4.5454% 0; }
  .hd .ch { height:26px }
  .bandh { position:absolute; top:3px; bottom:0; border-left:1px solid var(--line); padding-left:6px; font:600 12px var(--sans); color:var(--green); background:var(--green-tint); opacity:.9; overflow:hidden; white-space:nowrap }
  .ax .tk { position:absolute; top:4px; transform:translateX(-50%); font-size:11px; margin-left:0; color:var(--muted) }
  .bar { position:absolute; top:6px; height:12px; border-radius:3px; display:block }
  .bar:hover { outline:2px solid var(--saffron) }
  .note { position:absolute; top:4px; font-size:11px; color:var(--muted); white-space:nowrap; pointer-events:none }
  .anch .lab { font-weight:600; color:var(--ink); }
  .mk { position:absolute; top:3px; width:3px; height:18px; background:var(--ink); transform:translateX(-1px) }
  .mkl { position:absolute; top:4px; font-size:11px; color:var(--ink) }
  .sr { position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0) }
</style>
