---
// Shared shell for the Quran section's reference pages, in the style of the Isnād of the Ten Qirāʾāt page:
// a cream manuscript band, a heading block, view tabs, full-width view panels, then sources and a cite footer.
// Pages pass: slot "intro" (paragraphs under the heading), slot "panels" (one <section id="v-{id}"> per view),
// slot "after" (sources, notes) and the props below.
import Base from '../layouts/Base.astro';
import QuranSubnav from './QuranSubnav.astro';
import { longDate } from '../lib/quran';

interface View { id: string; label: string }
interface Props {
  title: string; pageTitle?: string; description: string; eyebrow: string; sub?: string;
  current: string; views: View[]; archived: string; cite: string; crumbs?: [string, string][];
}
const { title, pageTitle, description, eyebrow, sub, current, views, archived, cite, crumbs } = Astro.props;
---
<Base title={pageTitle || title} description={description} current="quran">
  <div class="wrap" style="padding-top:28px; padding-bottom:0">
    <QuranSubnav current={current} />
    {crumbs && <nav aria-label="Breadcrumb" class="muted" style="font-size:14px; margin:0 0 14px">{crumbs.map(([l, h], i) => <>{i > 0 && ' › '}{h ? <a href={h}>{l}</a> : l}</>)}</nav>}
  </div>
  <div class="ap-band" data-pagefind-body>
    <main class="ap">
      <p class="sub">{eyebrow}</p>
      <h1 data-pagefind-meta="title">{title}</h1>
      {sub && <p class="sub">{sub}</p>}
      <slot name="intro" />
      <div class="iq-tabs" role="tablist" aria-label="Views">
        {views.map((v, i) => <button type="button" role="tab" id={`t-${v.id}`} aria-controls={`v-${v.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-v={v.id}>{v.label}</button>)}
      </div>
    </main>
    <slot name="panels" />
    <main class="ap">
      <slot name="after" />
      <footer class="ap-foot">
        <p><strong>Archived</strong> {longDate(archived)}. <strong>How to cite this page:</strong> {cite}</p>
        <slot name="foot" />
      </footer>
    </main>
  </div>
</Base>
<style is:global>
  .ap-band { background: #faf7f0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .ap { max-width: 880px; margin: 0 auto; padding: 24px 18px 30px; color: #222; font: 17px/1.65 Georgia, 'Times New Roman', serif; }
  .ap h1 { font: 700 1.9rem/1.25 Georgia, 'Times New Roman', serif; margin: 0.3em 0 0.2em; color: #222; text-wrap: balance; }
  .ap .sub { color: #666; font-style: italic; margin: 0 0 1em; }
  .ap h2 { font: 700 1.3rem/1.3 Georgia, 'Times New Roman', serif; margin: 2em 0 0.5em; border-bottom: 1px solid #d8d2c2; padding-bottom: 0.2em; color: #1d5c4a; }
  .ap p { margin: 1em 0; }
  .ap a { color: #1d5c4a; }
  .ap ul { padding-left: 1.2em; }
  .ap li { margin: 0.3em 0; }
  .ap .a-scroll, .qs-wide .a-scroll { overflow-x: auto; }
  .ap table, .qs-table { border-collapse: collapse; width: 100%; font-size: 0.88rem; background: #fff; }
  .ap th, .ap td, .qs-table th, .qs-table td { border: 1px solid #d8d2c2; padding: 6px 8px; vertical-align: top; text-align: left; }
  .ap th, .qs-table th { background: rgba(29, 92, 74, 0.12); }
  .ap-foot { margin-top: 3em; font-size: 0.88rem; color: #666; border-top: 1px solid #d8d2c2; padding-top: 1em; overflow-wrap: anywhere; }
  .ap-foot strong { color: #222; }
  .iq-tabs { display: flex; flex-wrap: wrap; gap: 6px; margin: 22px 0 0; border-bottom: 2px solid #1d5c4a; }
  .iq-tabs button { font: 600 14px/1.2 var(--sans, system-ui), sans-serif; padding: 10px 16px; border: 1px solid #d8d2c2; border-bottom: 0; border-radius: 8px 8px 0 0; background: #fff; color: #333; cursor: pointer; margin-bottom: -2px; }
  .iq-tabs button[aria-selected="true"] { background: #1d5c4a; color: #fff; border-color: #1d5c4a; }
  .iq-tabs button:focus-visible, .qs-bar button:focus-visible { outline: 2px solid #b86b00; outline-offset: 2px; }
  .iq-panel { padding: 0 0 26px; }
  .iq-panel-head { max-width: 880px; margin: 0 auto; padding: 4px 18px 12px; font: 15px/1.55 var(--sans, system-ui), sans-serif; color: #333; }
  .iq-panel-head p { margin: 6px 0 10px; }
  .qs-wide { max-width: 1100px; margin: 0 auto; padding: 0 18px; font-family: var(--sans, system-ui), sans-serif; }
  .qs-bar { display: flex; flex-wrap: wrap; gap: 8px; margin: 8px 0; }
  .qs-bar button { font: 14px/1.2 var(--sans, system-ui), sans-serif; padding: 7px 14px; border-radius: 999px; border: 1px solid #d8d2c2; background: #fff; color: #222; cursor: pointer; }
  .qs-bar button[aria-pressed="true"] { background: #1d5c4a; color: #fff; border-color: #1d5c4a; }
  .qs-search { width: 100%; max-width: 460px; font: 16px var(--sans, system-ui), sans-serif; padding: 9px 12px; border: 1px solid #c9c2ae; border-radius: 8px; background: #fff; }
  .qs-count { font-size: 14px; color: #1d5c4a; margin: 6px 0 0; }
  .qs-d { color: #777; font-size: 0.9em; white-space: nowrap; font-variant-numeric: tabular-nums; }
  /* grouped view */
  .qs-groups { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 14px; }
  .qs-group { background: #fff; border: 1px solid #d8d2c2; border-radius: 10px; padding: 12px 16px; min-width: 0; }
  .qs-group > summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; gap: 10px; align-items: baseline; }
  .qs-group > summary::-webkit-details-marker { display: none; }
  .qs-group > summary b { font: 600 16px/1.35 Georgia, serif; color: #1d5c4a; }
  .qs-group > summary .n { font-size: 13px; color: #666; white-space: nowrap; }
  .qs-group ul { list-style: none; margin: 8px 0 0; padding: 0; font-size: 14px; line-height: 1.45; }
  .qs-group li { padding: 5px 0; border-top: 1px solid #efeadf; }
  .qs-group li a { color: #1d3d36; text-decoration: none; }
  .qs-group li a:hover { text-decoration: underline; }
  .qs-meta { display: block; color: #777; font-size: 12.5px; }
  /* timeline */
  .qs-tl { position: relative; margin: 6px 0 0 8px; padding-left: 26px; border-left: 2px solid #c9d8d2; }
  .qs-tl-band { position: relative; margin: 0 0 18px; }
  .qs-tl-band::before { content: ""; position: absolute; left: -34px; top: 6px; width: 12px; height: 12px; border-radius: 50%; background: #1d5c4a; border: 2px solid #faf7f0; }
  .qs-tl-band h3 { font: 700 15px/1.3 var(--sans, system-ui), sans-serif; color: #1d5c4a; margin: 0 0 6px; letter-spacing: .02em; }
  .qs-tl-band ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 8px; }
  .qs-tl-band li { background: #fff; border: 1px solid #e3ddcf; border-radius: 8px; padding: 8px 12px; font-size: 14px; line-height: 1.4; min-width: 0; }
  .qs-tl-band li a { color: #1d3d36; font-weight: 600; text-decoration: none; }
  .qs-tl-band li a:hover { text-decoration: underline; }
  .qs-table th button { font: inherit; font-weight: 600; background: none; border: 0; padding: 0; cursor: pointer; color: inherit; }
  .qs-table th button::after { content: " ↕"; color: #999; font-weight: 400; }
  .qs-table tr[hidden] { display: none; }
  .qs-panel-list { max-width: 1100px; margin: 0 auto; padding: 0 18px; font-family: var(--sans, system-ui), sans-serif; }
</style>
<script is:inline>
(() => {
  const tabs = [...document.querySelectorAll('.iq-tabs [role=tab]')];
  if (!tabs.length) return;
  function show(v, focus) {
    tabs.forEach((t) => {
      const on = t.dataset.v === v;
      t.setAttribute('aria-selected', String(on)); t.tabIndex = on ? 0 : -1;
      const p = document.getElementById(t.getAttribute('aria-controls'));
      if (p) p.hidden = !on;
      if (on && focus) t.focus();
    });
    try { history.replaceState(null, '', '#' + v); } catch (e) {}
  }
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => show(t.dataset.v));
    t.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      const j = (i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length;
      show(tabs[j].dataset.v, true);
    });
  });
  tabs.slice(1).forEach((t) => { const p = document.getElementById(t.getAttribute('aria-controls')); if (p) p.hidden = true; });
  const h = location.hash.slice(1);
  if (tabs.some((t) => t.dataset.v === h)) show(h);
  else if (h && document.getElementById(h)) { const p = document.getElementById(h).closest('[role=tabpanel]'); if (p) show(p.id.slice(2)); }

  /* searchable, sortable tables */
  const fold = (s) => s.normalize('NFD').replace(/[̀-ͯʿʾ‘’'ʿʾ]/g, '').toLowerCase();
  document.querySelectorAll('[data-qs-table]').forEach((box) => {
    const input = box.querySelector('.qs-search'), table = box.querySelector('table'), cnt = box.querySelector('.qs-count');
    const rows = [...table.tBodies[0].rows], txt = rows.map((r) => fold(r.textContent));
    const noun = cnt ? cnt.dataset.noun : '';
    input && input.addEventListener('input', () => {
      const v = fold(input.value.trim()); let n = 0;
      rows.forEach((r, i) => { const ok = !v || txt[i].includes(v); r.hidden = !ok; if (ok) n++; });
      if (cnt) cnt.textContent = n + ' ' + noun;
    });
    table.querySelectorAll('th button').forEach((b, col) => {
      let asc = true;
      b.addEventListener('click', () => {
        const key = (r) => r.cells[col].dataset.sort ?? fold(r.cells[col].textContent.trim());
        const num = rows.every((r) => !isNaN(parseFloat(key(r))) || key(r) === '');
        rows.sort((a, c) => { const x = key(a), y = key(c); if (num) { const nx = x === '' ? Infinity : +x, ny = y === '' ? Infinity : +y; return asc ? nx - ny : ny - nx; } return asc ? x.localeCompare(y) : y.localeCompare(x); });
        asc = !asc; rows.forEach((r) => table.tBodies[0].appendChild(r));
      });
    });
  });
  /* open-all / close-all for grouped views */
  document.querySelectorAll('[data-qs-groups]').forEach((box) => {
    box.querySelectorAll('[data-open]').forEach((b) => b.addEventListener('click', () => box.querySelectorAll('details.qs-group').forEach((d) => { d.open = b.dataset.open === '1'; })));
  });
})();
</script>
