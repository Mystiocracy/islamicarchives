---
import Base from '../../layouts/Base.astro';
import hist from '../../data/history.json';
import { longDate } from '../../lib/quran';
import { allWorks, allEras, eraOf } from '../../lib/site';

const eras = await allEras();
const works = await allWorks();
const perEra = new Map<string, number>();
for (const w of works) { const e = eraOf(w.data.year, eras); if (e) perEra.set(e.id, (perEra.get(e.id) || 0) + 1); }
const groups: Record<string, string> = hist.groups;
const groupKeys = Object.keys(groups);
const entries = [...hist.entries].sort((a, b) => a.from - b.from || a.to - b.to);
---
<Base title={hist.title} description={hist.intro} current="history">
  <div class="wrap" style="padding-top:40px; padding-bottom:56px; display:flex; flex-direction:column; gap:26px">
    <div>
      <h1 style="font-size:40px; margin:0 0 0.3em">{hist.title}</h1>
      <p class="muted" style="margin:0; font-size:17px; max-width:760px">{hist.intro}</p>
    </div>
    <div class="h-legend" aria-label="Key">{groupKeys.map((k) => <span><i class={`hd g-${k}`}></i>{groups[k]}</span>)}</div>

    <ol class="h-line">
      {entries.map((e) => {
        const n = e.era ? perEra.get(e.era) : 0;
        return (
          <li class={`h-ev g-${e.group}`}>
            <div class="h-date">{e.when}</div>
            <article class="h-card">
              <h2>{e.name}</h2>
              <p class="h-place">{e.place}</p>
              <p>{e.text}</p>
              {e.countries && e.countries.length > 0 && (
                <div class="h-countries"><span class="h-sub">Today's countries</span>
                  <ul>{e.countries.map((c: string) => <li>{c}</li>)}</ul></div>
              )}
              {e.rulers && e.rulers.length > 0 && (
                <div class="h-rulers"><span class="h-sub">Major rulers</span>
                  <ol>{e.rulers.map((r: any) => <li><span class="r-when">{r.when}</span><span class="r-name"><b>{r.name}</b> <em>{r.role}</em></span></li>)}</ol></div>
              )}
              <p class="h-links">
                {e.era && n ? <a href={`/library/?era=${e.era}`}>{n} writings from this period →</a> : null}
                {e.wiki ? <a href={e.wiki} rel="noopener" target="_blank">Further reading ↗</a> : null}
              </p>
            </article>
          </li>
        );
      })}
    </ol>

    <p class="cite-line"><span>Archived {longDate(hist.archived)} · Source: {hist.source_note}</span></p>
  </div>
</Base>
<style>
  .h-legend { display: flex; flex-wrap: wrap; gap: 8px 18px; font: 13px var(--sans); color: var(--muted); }
  .hd { display: inline-block; width: 12px; height: 12px; border-radius: 50%; margin-right: 6px; vertical-align: -1px; border: 4px solid var(--green); background: var(--surface); }
  .hd.g-c, .g-c { --c: var(--green); }
  .hd.g-p, .g-p { --c: var(--saffron-text); }
  .hd.g-d, .g-d { --c: #3b7f9a; }
  .hd.g-e, .g-e { --c: #7a4a8a; }
  .hd.g-m, .g-m { --c: #55605D; }
  .hd { border-color: var(--c); }
  .h-line { list-style: none; margin: 0; padding: 0; position: relative; }
  .h-line:before { content: ''; position: absolute; top: 6px; bottom: 6px; left: 150px; width: 3px; background: var(--green-line); border-radius: 2px; }
  .h-ev { position: relative; display: grid; grid-template-columns: 138px 1fr; gap: 0 38px; padding-bottom: 22px; }
  .h-ev:before { content: ''; position: absolute; left: 143px; top: 8px; width: 13px; height: 13px; border-radius: 50%; background: var(--surface); border: 4px solid var(--c); box-sizing: content-box; margin-left: -4px; }
  .h-date { text-align: right; font: 600 15px var(--sans); color: var(--ink-2); padding-top: 4px; }
  .h-card { background: var(--surface); border: 1px solid var(--line); border-left: 4px solid var(--c); border-radius: var(--radius); padding: 16px 20px; }
  .h-card h2 { font-size: 21px; margin: 0; }
  .h-place { margin: 2px 0 8px; font-size: 13px; color: var(--muted); letter-spacing: 0.02em; }
  .h-card p { margin: 0 0 8px; font-size: 15.5px; line-height: 1.6; }
  .h-card .h-place { font-size: 13px; }
  .h-links { display: flex; flex-wrap: wrap; gap: 6px 18px; font-size: 14px; margin: 4px 0 0 !important; }
  .h-links a { font-weight: 500; }
  @media (max-width: 700px) {
    .h-line:before { left: 8px; }
    .h-ev { grid-template-columns: 1fr; padding-left: 32px; padding-bottom: 18px; }
    .h-ev:before { left: 8px; top: 4px; }
    .h-date { text-align: left; padding: 0 0 6px; font-size: 14px; }
  }
  .h-sub { display: block; font-size: 12px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin: 10px 0 6px; }
  .h-countries ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .h-countries li { font-size: 13px; padding: 2px 10px; border: 1px solid var(--line); border-radius: 999px; }
  .h-rulers ol { list-style: none; margin: 0; padding: 0 0 0 14px; border-left: 2px solid var(--c); }
  .h-rulers li { position: relative; display: grid; grid-template-columns: 150px 1fr; gap: 10px; font-size: 14.5px; padding: 3px 0; }
  .h-rulers li::before { content: ''; position: absolute; left: -19px; top: 11px; width: 8px; height: 8px; border-radius: 50%; background: var(--c); }
  .r-when { color: var(--muted); font-variant-numeric: tabular-nums; }
  .r-name em { color: var(--muted); font-style: normal; font-size: 13px; }
  @media (max-width: 700px) { .h-rulers li { grid-template-columns: 1fr; gap: 0; } }
</style>
