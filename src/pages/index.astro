---
import Base from '../layouts/Base.astro';
import { hubOf } from '../lib/hubs';
import { longDate } from '../lib/quran';
import { website } from '../lib/schema';
import influences from '../data/influences.json';
import { updatesByDay } from '../lib/updates';
import { allWorks, allAuthors, allSubjects, allEras, eraSpan, authorPhoto, initials, years } from '../lib/site';

const works = await allWorks();
const authors = await allAuthors();
const subjects = await allSubjects();
const eras = await allEras();
const recent = (await updatesByDay()).slice(0, 4).flatMap((d) => d.batches.map((b) => ({ ...b, date: d.date }))).slice(0, 16);
const subjectCount = (id: string) => works.filter((w) => w.data.subjects.some((x) => x.id === id)).length;
const firstSentence = (t = '') => { const m = t.match(/^.*?[.!?](\s|$)/); return (m ? m[0] : t).trim(); };
const count = new Map<string, number>();
for (const w of works) count.set(w.data.author.id, (count.get(w.data.author.id) || 0) + 1);
// Thinkers timeline: every author, in order of birth (those without dates by the year of their first work)
const firstWork = new Map<string, number>();
for (const w of works) if (w.data.year) firstWork.set(w.data.author.id, Math.min(firstWork.get(w.data.author.id) ?? 9999, w.data.year));
const orderYear = (a: (typeof authors)[number]) => a.data.born ?? (influences.sortYear as Record<string, number>)[a.id] ?? firstWork.get(a.id) ?? 9999;
const stops = [...authors].sort((x, y) => orderYear(x) - orderYear(y) || x.data.name.localeCompare(y.data.name));
const shortName = (n: string) => n.replace(/\s*\(.*?\)/g, '').trim();
---
<Base current="home" jsonld={website}>
  <section style="background: var(--green-dark); color: #fff">
    <div class="wrap hero" style="padding-top: 44px; padding-bottom: 48px; display: flex; flex-direction: column; gap: 16px">
      <h1 class="hero-h1" style="font-weight:700; font-size: clamp(32px, 4vw, 52px); line-height:1.08">The writings of modern Muslim thinkers.</h1>
      <p class="hero-lede" style="margin:0; font-size:19px; line-height:1.55; color:#D7E3DF">Books, essays and articles from the 19th century to today. Search the full text, read online, download in the format you need, or send a work straight to your Kindle or inbox.</p>
      <form class="hero-search" action="/library/" method="get" role="search" style="display:flex; flex-wrap:wrap; gap:10px; margin-top:4px">
        <label for="q" class="sr-only">Search the archive</label>
        <input id="q" name="q" type="search" data-suggest placeholder="Search authors, titles, subjects or words in the text" style="flex:1 1 420px; min-height:54px; font-size:17px; border:0; min-width:0">
        <button class="btn btn-saffron" style="min-height:54px; padding:0 28px; font-size:17px" aria-label="Search"><svg class="only-mobile" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg><span class="hide-mobile">Search</span></button>
      </form>
    </div>
  </section>

  <div class="wrap">
    <section class="section">
      <div class="feature-tiles" style="display:grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap:18px">
        {[
          ['Search every word', 'Full-text search across hosted works, with filters for author, subject, era, language and type.'],
          ['Download any format', 'EPUB, PDF, Word and plain text, with linked footnotes and a table of contents. EPUB works on Kindle too.'],
          ['Send to Kindle or email', 'Save your Kindle address once on this device and send any hosted work to your Kindle or inbox in one click.'],
        ].map(([h, p]) => (
          <div class="card" style="padding:24px; display:flex; flex-direction:column; gap:10px">
            <h2 style="font-size:21px">{h}</h2>
            <p class="muted" style="margin:0">{p}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="section">
      <a href="/quran/corpus/" class="card" style="display:flex; flex-wrap:wrap; align-items:center; gap:16px 28px; padding:24px 28px; text-decoration:none; color:var(--ink)">
        <span lang="ar" dir="rtl" style="font-family:'Noto Naskh Arabic', serif; font-size:34px; color:var(--saffron-text)">المعجم</span>
        <span style="flex:1 1 360px; display:flex; flex-direction:column; gap:6px">
          <span style="font-family:var(--serif); font-weight:600; font-size:24px">Quran Word Corpus</span>
          <span class="muted">Read the Quran word by word, with the grammar and root of every word, a dictionary of roots, search in Arabic and English, a table of verbs and a concordance.</span>
        </span>
        <span class="btn btn-primary">Open the Quran tool →</span>
      </a>
    </section>

    <section class="section">
    <div class="tl-band" aria-labelledby="tl-h" role="group">
    <div class="tl-head">
      <div>
        <span lang="ar" dir="rtl" class="tl-ar">الأعلام</span>
        <h2 id="tl-h">Thinkers through time</h2>
      </div>
      <div class="tl-links">
        <button type="button" class="tl-play" aria-pressed="false">Pause</button>
        <a href="/timeline/">Full timeline →</a>
        <a href="/authors/">All authors A–Z →</a>
      </div>
    </div>
    <div class="tl-frame">
      <button type="button" class="tl-btn tl-prev" aria-label="Earlier thinkers">‹</button>
      <div class="tl-scroll" tabindex="0" role="region" aria-label="Timeline of thinkers, earliest first">
        <ol class="tl-track">
          {stops.map((a, i) => {
            const up = i % 2 === 0;
            const role = (a.data.roles || '').split(/[,;]/)[0].trim();
            return (
              <li class={`tl-item ${up ? 'up' : 'down'} ${i % 2 ? 'c2' : 'c1'}`}>
                <span class="tl-seg" aria-hidden="true"></span>
                <span class="tl-node" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 1l2.6 6.4L21 4.5l-2.9 6.4L24.5 12l-6.4 2.6L21 19.5l-6.4-2.9L12 23l-2.6-6.4L3 19.5l2.9-6.4L-.5 12l6.4-2.6L3 4.5l6.4 2.9z" fill="currentColor"/></svg></span>
                <a class="tl-card" href={`/authors/${a.id}/`}>
                  <span class="tl-medal">
                    <svg class="tl-ring" viewBox="0 0 120 120" aria-hidden="true">
                      <g fill="none" stroke="currentColor" stroke-width="1.6">
                        <rect x="21" y="21" width="78" height="78"/>
                        <rect x="21" y="21" width="78" height="78" transform="rotate(45 60 60)"/>
                      </g>
                      <circle cx="60" cy="60" r="57" fill="none" stroke="currentColor" stroke-width="3" stroke-dasharray="1 5.9" opacity=".7"/>
                    </svg>
                    {authorPhoto(a) ? <img src={authorPhoto(a)} alt="" width="76" height="76" loading="lazy" decoding="async" /> : <span class="tl-mono" aria-hidden="true">{initials(a.data.name)}</span>}
                  </span>
                  <span class="tl-stem" aria-hidden="true"></span>
                  <span class="tl-year">{orderYear(a) < 9999 ? orderYear(a) : ''}</span>
                  <span class="tl-info">
                    <strong>{shortName(a.data.name)}</strong>
                    <small>{[years(a.data) || (firstWork.has(a.id) ? `first work ${firstWork.get(a.id)}` : ''), (a.data.region || '').split(/[;(,]/)[0].trim()].filter(Boolean).join(' · ')}</small>
                    {role && <em>{role}</em>}
                  </span>
                </a>
              </li>
            );
          })}
        </ol>
      </div>
      <button type="button" class="tl-btn tl-next" aria-label="Later thinkers">›</button>
    </div>
    </div>
    </section>


    {recent.length > 0 && (
      <section class="section">
        <div class="tl-band rl-tile" role="group" aria-labelledby="rl-recent-h">
          <div class="tl-head">
            <div>
              <span lang="ar" dir="rtl" class="tl-ar">الجديد</span>
              <h2 id="rl-recent-h">Recently added</h2>
              <p>New authors and works, newest first.</p>
            </div>
            <div class="tl-links"><a href="/new/">All updates →</a><a href="/feed.xml">RSS</a></div>
          </div>
          <div class="tl-frame">
            <button type="button" class="tl-btn rl-prev" aria-label="Newer">‹</button>
            <div class="rl-scroll" tabindex="0" role="region" aria-label="Recently added authors and works">
              <ol class="rl-track">
                {recent.map((b, i) => (
                  <li class={`rl-item ${i % 2 ? 'c2' : 'c1'}`}>
                    <a class="rl-card" href={`/authors/${b.author.id}/`}>
                      <span class="tl-medal rl-medal">
                        <svg class="tl-ring" viewBox="0 0 120 120" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.6"><rect x="21" y="21" width="78" height="78"/><rect x="21" y="21" width="78" height="78" transform="rotate(45 60 60)"/></g><circle cx="60" cy="60" r="57" fill="none" stroke="currentColor" stroke-width="3" stroke-dasharray="1 5.9" opacity=".7"/></svg>
                        {authorPhoto(b.author) ? <img src={authorPhoto(b.author)} alt="" width="56" height="56" loading="lazy" decoding="async" /> : <span class="tl-mono" aria-hidden="true">{initials(b.author.data.name)}</span>}
                      </span>
                      <strong>{shortName(b.author.data.name)}</strong>
                      <span class="rl-meta">{b.newAuthor ? 'New author' : 'Added'}{b.works.length ? ` · ${b.works.length} ${b.works.length === 1 ? 'work' : 'works'}` : ''}</span>
                      <span class="rl-date">{longDate(b.date)}</span>
                    </a>
                  </li>
                ))}
              </ol>
            </div>
            <button type="button" class="tl-btn rl-next" aria-label="Older">›</button>
          </div>
        </div>
      </section>
    )}

    <section class="section">
      <div class="tl-band rl-tile" role="group" aria-labelledby="rl-subj-h">
        <div class="tl-head">
          <div>
            <span lang="ar" dir="rtl" class="tl-ar">المواضيع</span>
            <h2 id="rl-subj-h">Browse by subject</h2>
            <p>{subjects.length} subjects, each with a reading path to begin with.</p>
          </div>
          <div class="tl-links"><a href="/subjects/">All subjects →</a></div>
        </div>
        <div class="tl-frame">
          <button type="button" class="tl-btn rl-prev" aria-label="Previous subjects">‹</button>
          <div class="rl-scroll" tabindex="0" role="region" aria-label="Subjects">
            <ol class="rl-track">
              {subjects.map((s, i) => (
                <li class={`rl-item ${i % 2 ? 'c2' : 'c1'}`}>
                  <a class="rl-card rl-subject" href={`/subjects/${s.id}/`}>
                    <span class="tl-medal rl-medal">
                      <svg class="tl-ring" viewBox="0 0 120 120" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.6"><rect x="21" y="21" width="78" height="78"/><rect x="21" y="21" width="78" height="78" transform="rotate(45 60 60)"/></g><circle cx="60" cy="60" r="57" fill="none" stroke="currentColor" stroke-width="3" stroke-dasharray="1 5.9" opacity=".7"/></svg>
                      <span class="tl-mono rl-count" aria-hidden="true">{subjectCount(s.id)}</span>
                    </span>
                    <strong>{s.data.name}</strong>
                    <span class="rl-blurb">{firstSentence(hubOf(s.id)?.intro?.[0])}</span>
                    <span class="rl-meta">{subjectCount(s.id)} {subjectCount(s.id) === 1 ? 'work' : 'works'}</span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
          <button type="button" class="tl-btn rl-next" aria-label="Next subjects">›</button>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="section-head"><h2>From the archive</h2><button type="button" class="btn btn-quiet" id="pick-again" style="font-weight:500">Show others ↻</button></div>
      <div class="card" id="random-works" aria-live="polite"></div>
    </section>

    <section class="section" id="eras">
      <div class="section-head"><h2>Browse by era</h2></div>
      <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); border-top:3px solid var(--green)">
        {eras.map((e) => (
          <a href={`/library/?era=${e.id}`} style="text-decoration:none; color:var(--ink); padding:18px 18px 18px 0; display:flex; flex-direction:column; gap:6px">
            <span style="width:14px; height:14px; border-radius:50%; background:var(--saffron); margin-top:-27px; border:3px solid var(--ground)"></span>
            <span style="font-size:14px; font-weight:600; color:var(--saffron-text)">{eraSpan(e.data)}</span>
            <span style="font-family:var(--serif); font-weight:600; font-size:18px">{e.data.name}</span>
          </a>
        ))}
      </div>
    </section>
  </div>
<script is:inline>
  (function () {
    function shuffle(a) { for (var i = a.length - 1; i > 0; i--) { var j = Math.floor(Math.random() * (i + 1)); var t = a[i]; a[i] = a[j]; a[j] = t; } return a; }
    var still = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Recently added and Browse by subject: cards rise one at a time as they come into view; arrows, drag and a slow drift like the timeline.
    document.querySelectorAll('.rl-tile').forEach(function (tile) {
      var sc = tile.querySelector('.rl-scroll'), items = Array.prototype.slice.call(sc.querySelectorAll('.rl-item'));
      if (still || !('IntersectionObserver' in window)) { items.forEach(function (i) { i.classList.add('in'); }); }
      else {
        tile.classList.add('rl-js');
        var waiting = [], on = false;
        var io = new IntersectionObserver(function (es) {
          es.forEach(function (e) {
            var el = e.target, k = waiting.indexOf(el);
            if (e.isIntersecting) { if (!el.classList.contains('in') && k < 0) waiting.push(el); }
            else { if (k >= 0) waiting.splice(k, 1); el.classList.remove('in'); }
          });
        }, { root: sc, rootMargin: '0px 120px 0px 120px', threshold: 0 });
        items.forEach(function (i) { io.observe(i); });
        new IntersectionObserver(function (es) { on = es[0].isIntersecting; }, { threshold: 0.3 }).observe(sc);
        (function pop() {
          if (on && !document.hidden && waiting.length) {
            var el = waiting.splice(Math.floor(Math.random() * waiting.length), 1)[0]; el.classList.add('in');
          }
          setTimeout(pop, 450 + Math.random() * 900);
        })();
      }
      var held = false, idle = 0, pos = 0, last = 0, visible = false, wait = 2.5, pause = 0;
      function by(d) { sc.scrollBy({ left: d * Math.max(240, sc.clientWidth * 0.7), behavior: still ? 'auto' : 'smooth' }); idle = 4; }
      tile.querySelector('.rl-prev').addEventListener('click', function () { by(-1); });
      tile.querySelector('.rl-next').addEventListener('click', function () { by(1); });
      var down = false, sx = 0, sl = 0, moved = false;
      sc.addEventListener('mousedown', function (e) { down = true; moved = false; sx = e.pageX; sl = sc.scrollLeft; idle = 4; });
      window.addEventListener('mouseup', function () { down = false; sc.classList.remove('drag'); });
      window.addEventListener('mousemove', function (e) { if (!down) return; var dx = e.pageX - sx; if (Math.abs(dx) > 4) { moved = true; sc.classList.add('drag'); } sc.scrollLeft = sl - dx; });
      sc.addEventListener('click', function (e) { if (moved) { e.preventDefault(); e.stopPropagation(); moved = false; } }, true);
      sc.addEventListener('mouseenter', function () { held = true; }); sc.addEventListener('mouseleave', function () { held = false; idle = 2; });
      sc.addEventListener('focusin', function () { held = true; }); sc.addEventListener('focusout', function () { held = false; idle = 2; });
      ['wheel', 'touchstart'].forEach(function (ev) { sc.addEventListener(ev, function () { idle = 5; }, { passive: true }); });
      new IntersectionObserver(function (es) { visible = es[0].isIntersecting; }).observe(sc);
      (function tick(t) {
        var dt = last ? Math.min(t - last, 100) / 1000 : 0; last = t;
        if (idle > 0) idle -= dt;
        if (!still && !held && idle <= 0 && visible && !document.hidden && (wait -= dt) < 0) {
          var max = sc.scrollWidth - sc.clientWidth;
          if (Math.abs(sc.scrollLeft - pos) > 2) pos = sc.scrollLeft;
          if (pos >= max - 1) { if ((pause += dt) > 4) { pause = 0; pos = 0; sc.scrollLeft = 0; } }
          else { pos = Math.min(pos + 30 * dt, max); sc.scrollLeft = pos; }
        }
        requestAnimationFrame(tick);
      })(0);
    });

    // Thinkers timeline: the line carries on from left to right; of the authors on screen, one at a time rises out of it every so often.
    // An author who has scrolled well out of view sinks back, so they surface again on the next pass.
    (function () {
      var sc = document.querySelector('.tl-scroll'); if (!sc) return;
      var band = sc.closest('.tl-band'), items = Array.prototype.slice.call(sc.querySelectorAll('.tl-item'));
      // open at a random year rather than always at the beginning
      sc.scrollLeft = Math.floor(Math.random() * Math.max(0, (sc.scrollWidth - sc.clientWidth) * 0.9));
      if (still || !('IntersectionObserver' in window)) { items.forEach(function (i) { i.classList.add('in'); }); }
      else {
        band.classList.add('tl-js');
        var waiting = [], onScreen = false;
        var io = new IntersectionObserver(function (es) {
          es.forEach(function (e) {
            var el = e.target, k = waiting.indexOf(el);
            if (e.isIntersecting) { if (!el.classList.contains('in') && k < 0) waiting.push(el); }
            else { if (k >= 0) waiting.splice(k, 1); el.classList.remove('in'); }
          });
        }, { root: sc, rootMargin: '0px 260px 0px 260px', threshold: 0 });
        items.forEach(function (i) { io.observe(i); });
        new IntersectionObserver(function (es) { onScreen = es[0].isIntersecting; }, { threshold: 0.3 }).observe(sc);
        (function pop() {
          if (onScreen && !document.hidden && waiting.length) {
            // prefer authors actually in the visible window over the margin
            var box = sc.getBoundingClientRect();
            var seen = waiting.filter(function (el) { var r = el.getBoundingClientRect(); return r.right > box.left + 20 && r.left < box.right - 20; });
            var pool = seen.length ? seen : waiting;
            var el = pool[Math.floor(Math.random() * pool.length)];
            waiting.splice(waiting.indexOf(el), 1); el.classList.add('in');
          }
          setTimeout(pop, 280 + Math.random() * 420);
        })();
      }
      function by(dir) { sc.scrollBy({ left: dir * Math.max(240, sc.clientWidth * 0.7), behavior: still ? 'auto' : 'smooth' }); stopDrift(); }
      document.querySelector('.tl-prev').addEventListener('click', function () { by(-1); });
      document.querySelector('.tl-next').addEventListener('click', function () { by(1); });
      // drag to scroll with the mouse
      var down = false, sx = 0, sl = 0, moved = false;
      sc.addEventListener('mousedown', function (e) { down = true; moved = false; sx = e.pageX; sl = sc.scrollLeft; stopDrift(); });
      window.addEventListener('mouseup', function () { down = false; sc.classList.remove('drag'); });
      window.addEventListener('mousemove', function (e) { if (!down) return; var dx = e.pageX - sx; if (Math.abs(dx) > 4) { moved = true; sc.classList.add('drag'); } sc.scrollLeft = sl - dx; });
      sc.addEventListener('click', function (e) { if (moved) { e.preventDefault(); e.stopPropagation(); moved = false; } }, true);
      // slow, steady drift through time; at the far end it starts over from the Nahda.
      // Hovering or touching holds it; it carries on a few seconds after the visitor lets go. The Pause button stops it for good.
      var held = false, paused = still, idle = 0, pos = 0, last = 0, visible = false, wait = 2, pause = 0;
      var play = document.querySelector('.tl-play');
      function label() { play.textContent = paused ? 'Play' : 'Pause'; play.setAttribute('aria-pressed', String(paused)); }
      label();
      play.addEventListener('click', function () { paused = !paused; idle = 0; label(); });
      function stopDrift() { idle = 6; }
      sc.addEventListener('mouseenter', function () { held = true; });
      sc.addEventListener('mouseleave', function () { held = false; idle = 2; });
      ['wheel', 'touchstart', 'keydown', 'focusin', 'mousedown'].forEach(function (ev) { sc.addEventListener(ev, stopDrift, { passive: true }); });
      sc.addEventListener('touchend', function () { idle = 4; }, { passive: true });
      new IntersectionObserver(function (es) { visible = es[0].isIntersecting; }).observe(sc);
      function tick(t) {
        var dt = last ? Math.min(t - last, 100) / 1000 : 0; last = t;
        if (idle > 0) idle -= dt;
        if (!paused && !held && idle <= 0 && visible && !document.hidden && (wait -= dt) < 0) {
          var max = sc.scrollWidth - sc.clientWidth;
          if (Math.abs(sc.scrollLeft - pos) > 2) pos = sc.scrollLeft;
          if (pos >= max - 1) { if ((pause += dt) > 4) { pos = 0; pause = 0; sc.scrollLeft = 0; } }
          else { pos = Math.min(pos + 40 * dt, max); sc.scrollLeft = pos; }
        }
        requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    })();

    // Tickers: names in random order, scrolling for ever; each name that leaves on the left
    // is replaced on the right by a random name not already showing, so there is never a fixed sequence.
    document.querySelectorAll('[data-ticker]').forEach(function (box) {
      var track = box.querySelector('.ticker-track');
      var pool = shuffle(Array.prototype.slice.call(track.children));
      pool.forEach(function (el) { el.remove(); });
      if (still) { pool.forEach(function (el) { track.appendChild(el); }); box.classList.add('ticker-still'); return; }
      var shown = [], waiting = pool.slice();
      function next() {
        if (!waiting.length) waiting = shuffle(pool.filter(function (el) { return shown.indexOf(el) < 0; }));
        var el = waiting.pop();
        if (!el) return pool[Math.floor(Math.random() * pool.length)].cloneNode(true);  // short lists: repeat a name
        if (shown.indexOf(el) >= 0) el = el.cloneNode(true);
        return el;
      }
      function fill() {
        while (track.scrollWidth < box.clientWidth * 2 && shown.length < pool.length * 3) {
          var el = next(); track.appendChild(el); shown.push(el);
        }
      }
      fill();
      var x = 0, last = 0, paused = false, speed = +box.dataset.speed || 36;
      box.addEventListener('mouseenter', function () { paused = true; });
      box.addEventListener('mouseleave', function () { paused = false; });
      box.addEventListener('focusin', function () { paused = true; });
      box.addEventListener('focusout', function () { paused = false; });
      function step(t) {
        var dt = last ? Math.min(t - last, 100) / 1000 : 0; last = t;
        if (!paused && !document.hidden) x -= speed * dt;
        var first = track.firstElementChild;
        if (first) {
          var w = first.getBoundingClientRect().width + parseFloat(getComputedStyle(track).columnGap || 10);
          if (-x >= w) { x += w; first.remove(); shown.splice(shown.indexOf(first), 1); fill(); }
        }
        track.style.transform = 'translateX(' + x + 'px)';
        requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
      window.addEventListener('resize', fill);
    });

    // From the archive: five random works on every visit.
    var box = document.getElementById('random-works'), again = document.getElementById('pick-again'), works = null;
    function esc(t) { var d = document.createElement('div'); d.textContent = t == null ? '' : String(t); return d.innerHTML; }
    function draw() {
      if (!works) return;
      box.innerHTML = shuffle(works.slice()).slice(0, 5).map(function (w) {
        var meta = [w[4], w[5]].filter(Boolean).join(' · ');
        return '<article class="work-row"><div class="main">' +
          (meta ? '<div><span class="tag">' + esc((w[4] || '').toUpperCase()) + '</span>' + (w[5] ? ' <span class="muted" style="font-size:13px">' + esc(w[5]) + '</span>' : '') + '</div>' : '') +
