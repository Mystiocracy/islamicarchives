أبي معاوية الضرير","محمد بن ربيعة الكلابي ت","محمد بن عمر الواقدي","أبي أحمد محمد بن عبد الله بن الزبير الزبيري ق","محمد بن فضيل بن غزوان الضبي س","محمد بن القاسم الأسدي","وكيع بن الجراح د ق","يحيى بن يزيد بن عبد الملك النوفلي"],"tt":["الجماعة سوى البخاري","أبو عبد الملك أحمد بن إبراهيم البسري","أبو الجهم أحمد بن الحسين بن طلاب المشغراني","أحمد بن علي بن مسلم الأبار","أبو الحسن أحمد بن عمير بن يوسف بن جوصى الدمشقي","أحمد بن محمد بن الصباح البصري","أبو بكر أحمد بن محمد بن عمر البصري الحرابي نزيل بغداد","أحمد بن أبي رجاء نصر بن شاكر المقرىء","إدريس بن عبد الكريم الحداد المقرىء","أبو طاهر الحسن بن أحمد بن إبراهيم بن فيل الأسدي الأنطاكي","الحسين بن محمد بن حاتم المعروف بعبيد العجل","أبو عروبة الحسين بن محمد بن مودود الحراني","زكريا بن يحيى السجزي، ص","أبو بكر عبد الله بن محمد بن أبي الدنيا","عبد الرحمن بن عبيد الله بن أحمد الأسدي الحلبي المعروف بابن أخي الإمام","عبد الرحمن بن عبيد الله بن عبد العزيز الهاشمي الحلبي المعروف بابن أخي الإمام أيضا","عمر بن محمد بن بجير البجيري","أبو حاتم محمد بن إدريس الرازي","محمد بن علي الحكيم الترمذي","موسى بن هارون الحافظ","يحيى بن محمد بن صاعد"],"nf":["إبراهيم بن سعيد","إبراهيم بن سعيد الجوهري","إبراهيم الجوهري","الجوهري","إبراهيم بن سعيد الجهوري","إبراهيم بن سعد الجوهري"],"tags":["al-Tabri","Baghdad","Hafiz"],"refs":[["Thiqat","Vol:8"],["Siyar A'lam","12/149-151"],["Lisan al-Mizan","Vol:7"],["Tahdheeb al-Tahdheeb","Vol:1"],["Taqrib al-Tahdheeb","89"]],"up":"2011-01-06"},"f":["إبراهيم بن سعيد الجوهري"]},"9459":{"t":[[2904,5,0],[9660,2,0],[480,2,0],[124,1,1],[2989,1,0],[1593,1,0],[23727,1,0],[16822,1,0],[11251,1,0],[12463,1,0],[6704,1,0],[157,1,0],[809,1,0]],"s":[[9693,1,0],[2047,1,0],[3796,1,0],[4759,1,0],[1632,1,1],[18752,1,0],[4773,1,0],[12962,1,0],[19241,1,0]],"nt":13,"ns":9,"nt2":3,"ns2":0,"b":[[63,6],[129,2],[91,2],[749,2],[136,2],[29,1],[933,1],[298,1]],"nb":13,"r":[2904,4322,147,24,38,2,0]},"9460":{"t":[[127,18,4],[1770,1,1],[4,1,0],[179,1,0]],"s":[[94,2,1],[113,2,0],[2367,2,0],[5746,2,0],[35,1,0],[369,1,0],[2758,1,0],[3065,1,0],