---
import QuranStudy from '../../../components/QuranStudy.astro';
import WorkViews from '../../../components/WorkViews.astro';
import { allWorks } from '../../../lib/site';
import { longDate, SITE } from '../../../lib/quran';

const ARCHIVED = '2026-10-24';
const RX = /tafs[iīi]r|tafseer|commentary|exegesis|exegetical|interpretation of the (qur|kor)|message of the qur|towards understanding the qur|zilal|ẓilāl|translation of the (meanings|qur)/i;
const works = (await allWorks()).filter((w) => w.data.subjects.some((s) => s.id === 'quranic-studies') &&
  (RX.test([w.data.title, w.data.titleOriginal, w.data.summary, w.data.keywords.join(' ')].filter(Boolean).join(' ')) || w.data.type === 'Translation'));
const langs = new Set(works.map((w) => w.data.language)).size;
const hosted = works.filter((w) => w.data.rights !== 'link-only').length;
const cite = `Islamic Internet Archives. “Tafseer: Commentaries and Translations of the Qur'an.” Archived ${longDate(ARCHIVED)}. ${SITE}/quran/tafsir/.`;
const views = [{ id: 'list', label: 'Library' }, { id: 'authors', label: 'By author' }, { id: 'timeline', label: 'Timeline' }, { id: 'language', label: 'By language' }, { id: 'table', label: 'Table' }];
---
<QuranStudy title="Tafseer" pageTitle="Tafseer: Qur'an commentaries and translations" eyebrow="Interpretation of the Qur'an"
  sub={`${works.length} commentaries and translations in ${langs} languages, shown five ways. Archived ${longDate(ARCHIVED)}.`}
  description="Commentaries on the Qur'an and translations with commentary in the archive, shown by author, by date, by language and as a searchable table, with an archived date and citation for each."
  current="tafsir" views={views} archived={ARCHIVED} cite={cite}>
  <Fragment slot="intro">
    <p>This page gathers the commentaries on the Qur'an in the archive, together with translations that carry their own notes or commentary and writings on how the Qur'an is interpreted. {hosted} of them can be read here in full; the rest link to a free copy elsewhere. Every view shows the same works:</p>
    <ul>
      <li><strong>Library:</strong> search, filter by language and type, with the archived date and citation for each work.</li>
      <li><strong>By author:</strong> each commentator or translator with his works, oldest first.</li>
      <li><strong>Timeline:</strong> the works by year of publication.</li>
      <li><strong>By language:</strong> the works grouped by the language they are written in.</li>
      <li><strong>Table:</strong> everything in one list that you can search and sort.</li>
    </ul>
  </Fragment>
  <Fragment slot="panels">
    <WorkViews works={works} noun="works" placeholder="Search tafseer by title, author, language or topic" />
  </Fragment>
  <Fragment slot="after">
    <h2>How this list is made</h2>
    <p>A work appears here when it is filed under Qur'anic studies in the library and its title, original title, summary or keywords name it as a tafsīr, commentary, exegesis or translation of the Qur'an, or when it is catalogued as a translation. A commentary filed under another subject, or described in other words, may be missing; the complete subject list is under <a href="/quran/works/">Works on the Qur'an</a>, and every work can be found from the <a href="/library/?subject=quranic-studies">library</a>.</p>
    <h2>Related in the Quran Hub</h2>
    <ul>
      <li><a href="/quran/corpus/">Quran Word Corpus</a>: read the Qur'an word by word with grammar and roots</li>
      <li><a href="/quran/manuscripts/qiraat-isnad/">Isnād of the Ten Qirāʾāt</a>: how the readings were transmitted</li>
      <li><a href="/quran/works/">Works on the Qur'an</a>: every work in the archive on the Qur'an and its sciences</li>
      <li><a href="/quran/manuscripts/">Manuscript catalogue</a> and <a href="/quran/scholars/">manuscript scholars</a></li>
    </ul>
  </Fragment>
  <p slot="foot">Each work carries its own archived date and citation in the Library view. Dates of publication are those recorded for the edition held or linked.</p>
</QuranStudy>
