---
import '../styles/global.css';
interface Props { title?: string; description?: string; current?: string; noindex?: boolean }
const { title, description = 'Free writings of modern Muslim thinkers, from the 19th century to today: searchable, readable online and downloadable.', current = '', noindex = false } = Astro.props;
const full = title ? `${title} – Islamic Archives` : 'Islamic Archives – Archive of Modern Islamic Thought';
const nav = [
  { href: '/library/', label: 'Library', key: 'library' },
  { href: '/authors/', label: 'Authors', key: 'authors' },
  { href: '/subjects/', label: 'Subjects', key: 'subjects' },
  { href: '/quran/', label: 'Quran', key: 'quran' },
  { href: '/about/', label: 'About', key: 'about' },
];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{full}</title>
<meta name="description" content={description}>
{noindex && <meta name="robots" content="noindex">}
<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)}>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600;8..60,700&family=Noto+Naskh+Arabic:wght@500&family=Noto+Nastaliq+Urdu:wght@500&display=swap" rel="stylesheet">
<meta property="og:title" content={full}>
<meta property="og:description" content={description}>
<slot name="head" />
  <script is:inline src="/js/suggest.js"></script>
</head>
<body>
<a class="sr-only" href="#main">Skip to content</a>
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/">
      <svg width="40" height="40" viewBox="0 0 40 40" aria-hidden="true"><rect x="6" y="6" width="28" height="28" fill="none" stroke="#1E5A4C" stroke-width="2.5"/><rect x="6" y="6" width="28" height="28" fill="none" stroke="#C8892B" stroke-width="2.5" transform="rotate(45 20 20)"/><circle cx="20" cy="20" r="4" fill="#1E5A4C"/></svg>
      <span><span class="brand-name">Islamic Archives</span><span class="brand-sub">ARCHIVE OF MODERN ISLAMIC THOUGHT</span></span>
    </a>
    <button type="button" class="menu-btn" aria-expanded="false" aria-controls="site-menu" aria-label="Menu">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path class="i-open" d="M4 7h16M4 12h16M4 17h16"/><path class="i-close" d="M6 6l12 12M18 6 6 18"/></svg>
    </button>
    <div class="site-menu" id="site-menu">
      <nav class="main-nav" aria-label="Main">
        {nav.map((n) => <a href={n.href} aria-current={current === n.key ? 'page' : undefined}>{n.label}</a>)}
      </nav>
      <a class="btn btn-quiet kindle-link" href="/delivery/" aria-current={current === 'delivery' ? 'page' : undefined}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="5" y="2.5" width="14" height="19" rx="2"/><path d="M9 18h6"/></svg>My Kindle &amp; email
      </a>
    </div>
  </div>
  {current !== 'home' && (
    <div class="site-search">
      <form class="wrap" action="/library/" method="get" role="search">
        <label for="hq" class="sr-only">Search the archive</label>
        <span class="site-search-box">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          <input id="hq" name="q" type="search" data-suggest placeholder="Search authors, titles, subjects…">
        </span>
        <button class="btn btn-primary" type="submit">Search</button>
      </form>
    </div>
  )}
</header>
<main id="main">
  <slot />
</main>
<footer class="site-footer">
  <div class="wrap">
    <div class="col">
      <span class="h" style="font-family: var(--serif); font-size: 20px">Islamic Archives</span>
      <p style="margin:0; font-size:14px; line-height:1.6">A free, independent, non-commercial archive. Inclusion is not endorsement: the archive spans traditionalist, reformist, Sufi, Salafi, Shia and modernist thought.</p>
    </div>
    <nav aria-label="About">
      <span class="h">About</span>
      <a href="/about/">Mission and editorial policy</a>
      <a href="/permissions/">Copyright and permissions</a>
      <a href="/about/#cite">How to cite the archive</a>
      <a href="/help/kindle/">How to send books to your Kindle</a>
    </nav>
    <nav aria-label="Get involved">
      <span class="h">Get involved</span>
      <a href="/about/#volunteer">Volunteer to transcribe or proofread</a>
      <a href="mailto:contact@islamicarchives.org?subject=Suggestion">Suggest an author or work</a>
      <a href="/permissions/#takedown">Takedown requests</a>
    </nav>
    <div class="col">
      <span class="h">Contact</span>
      <a href="mailto:contact@islamicarchives.org" style="color:#E9C78D">contact@islamicarchives.org</a>
      <a href="mailto:permissions@islamicarchives.org" style="color:#E9C78D">permissions@islamicarchives.org</a>
    </div>
  </div>
</footer>
<script is:inline>
  (function () {
    var b = document.querySelector('.menu-btn'), h = document.querySelector('.site-header');
    if (!b || !h) return;
    b.addEventListener('click', function () {
      var open = h.classList.toggle('menu-open');
      b.setAttribute('aria-expanded', String(open));
    });
  })();
</script>
</body>
</html>
