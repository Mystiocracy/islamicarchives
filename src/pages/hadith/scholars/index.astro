---
import Base from '../../../layouts/Base.astro';
import { longDate } from '../../../lib/quran';
import fs from 'node:fs';

const ARCHIVED = '2026-10-24';
const TITLE = 'Directory of Muslim Scholars';
const D = JSON.parse(fs.readFileSync('public/hadith/scholars/index.json', 'utf8'));
const fmt = (n: number) => n.toLocaleString('en-GB');
const byRank = D.ranks.map((r: string, i: number) => [r, D.n.filter((x: any[]) => x[3] === i).length]).filter((x: any[]) => x[1] > 20);
---
<Base title={TITLE} description={`${fmt(D.n.length)} Companions, Followers, narrators and later scholars from the Muslim Scholars Database, searchable in Arabic and English.`} current="hadith">
  <div class="wrap" style="padding-top:28px; padding-bottom:0">
    <nav aria-label="Breadcrumb" class="muted" style="font-size:14px; margin:0 0 14px"><a href="/hadith/">Hadith Hub</a> › <a href="/hadith/narrators/">Narrators of the Ḥadīth</a> › Directory of Muslim Scholars</nav>
  </div>
  <div class="ap-band" data-pagefind-body>
    <div class="ap">
      <p class="sub">Tarājim al-ʿulamāʾ · <span lang="ar" dir="rtl">تراجم العلماء</span></p>
      <h1>Directory of Muslim Scholars</h1>
      <p class="sub">{fmt(D.n.length)} people from the Companions to the present, from the Muslim Scholars Database of the Arees Institute. Archived {longDate(ARCHIVED)}.</p>
      <p>Search by name in Arabic or English, or by the database's ID number, and tap a row for the full entry: lineage, family, dates, places, Ibn Ḥajar's verdict, teachers and students, the lists of al-Mizzī's <em>Tahdhīb al-Kamāl</em>, and the books of rijāl that mention the person. The {fmt(D.n.filter((x: any[]) => x[8] >= 0).length)} narrators who also appear in the <a href="/hadith/narrators/">isnad atlas</a> link straight to it.</p>
      <p class="sd-ranks">{byRank.map(([r, c]: any[]) => <span>{r} <b>{fmt(c)}</b></span>)}</p>
    </div>
  </div>
  <section class="sd" id="sd" aria-label="Scholar directory">
    <div class="sd-bar">
      <label for="sdq" class="sr-only">Search</label>
      <input id="sdq" type="search" placeholder="Search: الشافعي, Shafi'i, 20002…" autocomplete="off">
      <label for="sdr" class="sr-only">Rank</label><select id="sdr"></select>
      <label for="sdc" class="sr-only">City</label><select id="sdc"></select>
      <label class="sd-chk"><input type="checkbox" id="sdg"> With a grade</label>
      <label class="sd-chk"><input type="checkbox" id="sda"> In the isnad atlas</label>
      <span id="sdn" class="muted"></span>
    </div>
 <div class="sd-th" id="sdth" role="group" aria-label="Collections"></div>
    <p id="sdload" class="muted" style="text-align:center; padding:30px 0">Loading the directory…</p>
    <div class="sd-main">
      <div class="sd-tw"><table>
        <thead><tr><th data-k="id" class="r" aria-sort="ascending">ID</th><th data-k="n">Name</th><th>Arabic</th><th data-k="g">Rank · generation</th><th>City</th><th data-k="d" class="r">Died (AH)</th><th>Grade</th><th data-k="h" class="r" title="Chains in the isnad atlas">Chains</th></tr></thead>
        <tbody id="sdb"></tbody>
      </table></div>
      <aside class="sd-p" id="sdp" hidden aria-live="polite"></aside>
    </div>
    <div class="sd-pg" id="sdpg"></div>
  </section>
  <div class="ap-band" style="border-bottom:0">
    <div class="ap">
      <h2>About the data</h2>
      <p>The Muslim Scholars Database was built by the Arees Institute from the classical books of men: Ibn Ḥajar's <em>Tahdhīb al-Tahdhīb</em> and <em>Taqrīb</em> for the narrators of the Six Books, Ibn Ḥibbān's <em>al-Thiqāt</em> and al-Bukhārī's <em>al-Tārīkh al-Kabīr</em> for other narrators, Ibn Saʿd and Ibn Ḥajar's <em>al-Iṣāba</em> for the Companions, and al-Dhahabī's <em>Siyar</em> for later scholars. The English entries were extracted and translated largely by computer, and the database's own estimate is that about 5% of its records contain errors or duplicates. Most people have no recorded birth or death year. Every entry here links back to its page on the database.</p>
      <footer class="ap-foot">
        <p><strong>Archived</strong> {longDate(ARCHIVED)}. <strong>Source:</strong> Muslim Scholars Database, Arees Institute, <a href="https://muslimscholars.info/">muslimscholars.info</a>.</p>
      </footer>
    </div>
  </div>
  <script is:inline src="/js/scholars-dir.js?v=2" defer></script>
</Base>
<style is:global>
  .ap-band { background: #faf7f0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .ap { max-width: 880px; margin: 0 auto; padding: 24px 18px 30px; color: #222; font: 17px/1.65 Georgia, 'Times New Roman', serif; }
  .ap h1 { font: 700 1.9rem/1.25 Georgia, 'Times New Roman', serif; margin: 0.3em 0 0.2em; color: #222; }
  .ap .sub { color: #666; font-style: italic; margin: 0 0 1em; }
  .ap h2 { font: 700 1.3rem/1.3 Georgia, 'Times New Roman', serif; margin: 1.4em 0 0.5em; border-bottom: 1px solid #d8d2c2; padding-bottom: 0.2em; color: #1d5c4a; }
  .ap a { color: #1d5c4a; }
  .ap-foot { margin-top: 2em; font-size: 0.88rem; color: #666; border-top: 1px solid #d8d2c2; padding-top: 1em; }
  .sd-ranks { display: flex; flex-wrap: wrap; gap: 8px; font: 14px var(--sans); }
  .sd-ranks span { border: 1px solid #d8d2c2; border-radius: 999px; padding: 3px 12px; background: #fff; }
  .sd { max-width: min(1500px, 100%); margin: 0 auto; padding: 18px clamp(12px, 2vw, 32px) 34px; font-family: var(--sans); }
  .sd .ar { font-family: 'Noto Naskh Arabic', serif; }
  .sd-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 14px; margin-bottom: 12px; }
  .sd-bar input[type="search"] { flex: 1 1 280px; max-width: 460px; padding: 9px 12px; font-size: 15px; }
  .sd-bar select { padding: 8px 10px; font-size: 14px; }
  .sd-chk { font-size: 14px; color: var(--ink-2); display: flex; gap: 6px; align-items: center; }
  .sd-th { display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 12px; }
  .sd-th button { font: 500 13px var(--sans); border: 1px solid var(--line); background: var(--surface); border-radius: 999px; padding: 5px 12px; cursor: pointer; color: var(--ink-2); }
  .sd-th button b { color: var(--muted); font-weight: 600; margin-left: 3px; }
  .sd-th button[aria-pressed="true"] { background: var(--green-dark); color: #fff; border-color: var(--green-dark); }
  .sd-th button[aria-pressed="true"] b { color: #E9C78D; }
  .sd-main { display: grid; grid-template-columns: minmax(0, 1fr); gap: 14px; align-items: start; }
  .sd.open .sd-main { grid-template-columns: minmax(0, 1fr) 420px; }
  .sd-tw { overflow: auto; max-height: 75vh; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); }
  .sd-tw table { border-collapse: collapse; width: 100%; font-size: 14px; }
  .sd-tw th, .sd-tw td { padding: 7px 10px; border-bottom: 1px solid var(--line-2); text-align: left; vertical-align: top; }
  .sd-tw th { font: 600 12px var(--sans); text-transform: uppercase; letter-spacing: .05em; color: var(--muted); background: #faf7f0; position: sticky; top: 0; z-index: 1; }
  .sd-tw th[data-k] { cursor: pointer; } .sd-tw th[aria-sort] { color: var(--green); }
  .sd-tw td.r, .sd-tw th.r { text-align: right; font-variant-numeric: tabular-nums; }
  .sd-tw td.ar { text-align: right; font-size: 16px; }
  .sd-tw tr { cursor: pointer; } .sd-tw tbody tr:hover { background: var(--green-tint); } .sd-tw tr.on { background: #fff4e5; }
  .sd-n { border: 0; background: none; padding: 0; font: 600 14px var(--sans); color: var(--green); cursor: pointer; text-align: left; }
  .sd-pg { display: flex; gap: 12px; align-items: center; justify-content: center; margin-top: 12px; font-size: 14px; color: var(--muted); }
  .sd-pg button { border: 1px solid var(--line); background: var(--surface); border-radius: 999px; padding: 7px 16px; cursor: pointer; font: 500 14px var(--sans); color: var(--green); }
  .sd-p { position: sticky; top: 80px; max-height: calc(100vh - 100px); overflow-y: auto; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); padding: 18px 20px 22px; font-size: 14.5px; }
  .sd-x { float: right; border: 0; background: none; font-size: 26px; line-height: 1; cursor: pointer; color: var(--muted); }
  .sd-p .eyebrow { text-transform: uppercase; letter-spacing: .07em; font-size: 12px; color: var(--muted); margin: 0; }
  .sd-p h2 { font-size: 28px; line-height: 1.45; text-align: right; margin: 6px 0 0; }
  .sd-p .en { font: 600 19px/1.3 var(--serif); margin: 2px 0 6px; }
  .sd-p .full { color: var(--muted); font-size: 13.5px; margin: 0 0 8px; }
  .sd-p .verd { font: 17px/1.6 'Noto Naskh Arabic', serif; text-align: right; background: #fff4e5; border-radius: 8px; padding: 6px 10px; }
  .sd-p dl { display: grid; grid-template-columns: auto 1fr; gap: 5px 14px; margin: 10px 0; }
  .sd-p dt { color: var(--muted); } .sd-p dd { margin: 0; }
  .sd-p h3 { font: 600 12px var(--sans); text-transform: uppercase; letter-spacing: .07em; color: var(--muted); margin: 16px 0 6px; }
  .sd-p .bio { font: 15px/1.6 var(--serif); margin: 0; }
  .sd-p .ppl { margin: 0; line-height: 1.7; }
  .sd-l { border: 0; background: none; padding: 0; color: var(--green); cursor: pointer; font: inherit; text-decoration: underline; text-underline-offset: 2px; }
  .sd-p .kam { margin: 0; padding: 0 1.5em 0 0; font: 15.5px/1.7 'Noto Naskh Arabic', serif; max-height: 260px; overflow-y: auto; }
  .sd-p .forms { font-size: 16px; text-align: right; margin: 0; }
  .sd-p .tags { display: flex; flex-wrap: wrap; gap: 6px; margin: 14px 0 0; }
  .sd-p .tags span { font-size: 12.5px; border: 1px solid var(--line); border-radius: 999px; padding: 2px 10px; background: #faf7f0; }
  .sd-p .refs, .sd-p .src { font-size: 13px; color: var(--muted); margin: 12px 0 0; }
  .sd-btn { display: inline-block; background: var(--green); color: #fff !important; text-decoration: none; border-radius: 8px; padding: 8px 14px; font-weight: 600; font-size: 14px; }
  @media (max-width: 1000px) { .sd.open .sd-main { grid-template-columns: 1fr; } .sd-p { position: static; max-height: none; order: -1; } }
</style>
