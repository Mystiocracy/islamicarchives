---
import Base from '../../../../layouts/Base.astro';
import '../../../../styles/hadith.css';
import { muslim } from '../../../../lib/hadith';

export function getStaticPaths() {
  return muslim().books.map((b) => ({ params: { k: String(b.k) } }));
}
const k = Number(Astro.params.k);
const { books, hadiths } = muslim();
const book = books.find((b) => b.k === k)!;
const i = books.indexOf(book);
const list = hadiths.filter((h) => h.book === k);
const line = (en: string, ar: string) => {
  const t = en.replace(/\s+/g, ' ').trim() || ar.replace(/\s+/g, ' ');
  return t.length > 230 ? t.slice(0, 229) + '…' : t;
};
---
<Base title={`${book.name} – Ṣaḥīḥ Muslim`} description={`Book ${book.k} of Ṣaḥīḥ Muslim, ${book.name}: ${book.count} ḥadīth in Arabic and English.`} current="hadith">
  <div class="hd">
    <nav class="hd-crumb" aria-label="Breadcrumb"><a href="/hadith/">Hadith Hub</a> › <a href="/hadith/muslim/">Ṣaḥīḥ Muslim</a> › Book {book.k}</nav>
    <header class="hd-head">
      <span class="eyebrow">Ṣaḥīḥ Muslim · Book {book.k}</span>
      <h1>{book.name}</h1>
      <span class="book">{book.count} ḥadīth</span>
    </header>
    <ol class="hd-list">
      {list.map((h) => <li><a href={`/hadith/muslim/${h.n}/`}><span class="no">{h.n}</span><span class="tx">{line(h.en, h.ar)}</span></a></li>)}
    </ol>
    <nav class="hd-nav" aria-label="Neighbouring books">
      {books[i - 1] ? <a href={`/hadith/muslim/book/${books[i - 1].k}/`}>← Book {books[i - 1].k}: {books[i - 1].name}</a> : <span></span>}
      {books[i + 1] ? <a href={`/hadith/muslim/book/${books[i + 1].k}/`}>Book {books[i + 1].k}: {books[i + 1].name} →</a> : <span></span>}
    </nav>
  </div>
</Base>
