---
import Base from '../../../layouts/Base.astro';
import QuranSubnav from '../../../components/QuranSubnav.astro';
import items from '../../../data/scholars.json';
const groups = ['Scholars', 'Projects and centres'];
---
<Base title="Scholars of Quranic manuscripts" description="Scholars and projects that study early Qur'an manuscripts." current="quran">
  <div class="wrap" style="padding-top:40px; padding-bottom:40px">
    <QuranSubnav current="scholars" />
    <h1 style="font-size:40px; margin:0 0 0.4em">Scholars of Quranic manuscripts</h1>
    <div class="prose" style="font-family:var(--sans); font-size:17px; max-width:760px">
      <p>Researchers and projects working on early Qur'an manuscripts: palaeography, codicology, palimpsests, dating and textual variants. The list is in no order of importance, mixes Muslim and non-Muslim scholarship, and does not imply agreement with anyone’s conclusions. Affiliations may have changed; each link goes to a profile or project page.</p>
    </div>
    {groups.map((g) => (
      <section style="margin-top:36px">
        <h2 style="font-size:26px; margin-bottom:14px">{g}</h2>
        <div style="display:grid; grid-template-columns:repeat(auto-fill,minmax(320px,1fr)); gap:16px">
          {items.filter((x) => x.group === g).map((x) => (
            <article class="card" style="padding:16px 18px; font-family:var(--sans)">
              <h3 style="font-size:18px; margin:0 0 2px">{x.name}{x.nameNative && <span dir="rtl" lang="ar" style="font-family:'Noto Naskh Arabic',serif; margin-left:10px">{x.nameNative}</span>}</h3>
              {x.affiliation && <p style="margin:0 0 8px; font-size:14px; color:var(--ink-2)">{x.affiliation}</p>}
              <p style="margin:0 0 10px; font-size:15px; line-height:1.55">{x.description}</p>
              <a href={x.url} rel="noopener" style="font-size:14px; font-weight:500">{x.urlLabel || 'Profile'} →</a>
            </article>
          ))}
        </div>
      </section>
    ))}
  </div>
</Base>
