ErrorDocument 404 /404.html
DirectoryIndex index.html index.php

# Correct types for the downloads
AddType application/epub+zip .epub
AddType application/vnd.openxmlformats-officedocument.wordprocessingml.document .docx
AddType text/plain;charset=utf-8 .txt

# Force HTTPS and the bare domain
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# Never serve the mail settings or the PHP library sources
RewriteRule ^api/(config\.php|vendor/|composer\.(json|lock)) - [F,L]

# Cache static files
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>

# Compress text files (the Quran data files shrink by about 80%)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml
</IfModule>

# Old per-ḥadīth addresses (/hadith/bukhari/123/) now open that ḥadīth inside its book page
RewriteRule ^hadith/bukhari/([0-9]+[a-z]?)/?$ /hadith/bukhari/go/?n=$1 [R=302,L]
