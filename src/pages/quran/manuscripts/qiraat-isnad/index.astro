        const t = [...fr.querySelectorAll('li[data-name]')].find((li) => li.dataset.name === j.dataset.ref);
        if (!t) return;
        let a = t; while (a && a !== fr) { if (a.tagName === 'LI') setOpen(a, true); a = a.parentElement; }
        const box = t.querySelector(':scope > .iq-box'), fb = fr.getBoundingClientRect(), bb = box.getBoundingClientRect();
        fr.scrollLeft += bb.left - fb.left - fr.clientWidth / 2 + bb.width / 2;
        fr.scrollTop += bb.top - fb.top - 40;
        box.classList.remove('flash'); void box.offsetWidth; box.classList.add('flash');
        if (fr.getBoundingClientRect().top < 0) fr.scrollIntoView({ block: 'start' });
        return;
      }
      const b = e.target.closest('button.iq-h');
      if (!b || moved) return;
      const li = b.closest('li');
      setOpen(li, li.classList.contains('closed'));
    });
  }
  const center = (fr) => { fr.scrollLeft = (fr.scrollWidth - fr.clientWidth) / 2; };

  const org = document.getElementById('iq-org'), fr = document.getElementById('iq-frame');
  draggable(fr);
  function level(l) {
    org.querySelectorAll('li').forEach((li) => {
      const k = li.dataset.k;
      let open = true;
      if (l === 'r' && (k === 'r' || k === 'q')) open = false;
      if (l === 'i') open = !!li.querySelector(":scope > ul li[data-k='i']") || !!li.querySelector(":scope > ul > li[data-k='x']") || !!li.querySelector(":scope > ul li[data-k='x']");
