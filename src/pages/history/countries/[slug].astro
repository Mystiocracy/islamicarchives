---
import Base from '../../../layouts/Base.astro';
import hist from '../../../data/history.json';
import { longDate } from '../../../lib/quran';
import { allWorks, allEras, eraOf } from '../../../lib/site';
import { countryIndex, entryId, type Country } from '../../../lib/history';

export async function getStaticPaths() {
  return countryIndex().map((c) => ({ params: { slug: c.slug }, props: { country: c } }));
}
const { country } = Astro.props as { country: Country };
const eras = await allEras();
const works = await allWorks();
const perEra = new Map<string, number>();
for (const w of works) { const e = eraOf(w.data.year, eras); if (e) perEra.set(e.id, (perEra.get(e.id) || 0) + 1); }
const first = country.periods[0].entry, last = country.periods[country.periods.length - 1].entry;
const span = `${first.when.split('–')[0].trim()} – ${last.to >= 9999 ? 'today' : last.to}`;
---
<Base title={`${country.name} · History Hub`} description={`The history of ${country.name} through the Muslim empires and caliphates: ${country.periods.length} periods, ${span}.`} current="history">
  <div class="wrap" style="padding-top:40px; padding-bottom:56px">
    <p class="muted" style="margin:0 0 6px; font-size:14px"><a href="/history/">History Hub</a> › <a href="/history/countries/">Countries</a> › {country.name}</p>
    <p class="kick">History of</p>
    <h1 style="font-size:40px; margin:0 0 0.2em">{country.name}</h1>
    <p class="muted" style="margin:0 0 28px; font-size:16px">{country.periods.length} periods · {span}. Each period below is a power that ruled all or part of what is now {country.name}.</p>
    <ol class="cp">
      {country.periods.map(({ entry: e, note }) => { const n = e.era ? perEra.get(e.era) : 0; return (
        <li class={`g-${e.group}`}>
          <div class="cp-when">{e.when}</div>
          <article>
            <h2><a href={`/history/#${entryId(e.name)}`}>{e.name}</a>{note ? <span class="cp-note">{note}</span> : null}</h2>
            <p class="cp-place">{e.place}</p>
            <p>{e.text}</p>
            {e.rulers && e.rulers.length > 0 && <p class="cp-rulers"><b>Rulers:</b> {e.rulers.map((r) => `${r.name} (${r.when})`).join(' · ')}</p>}
            <p class="cp-links">
              {e.era && n ? <a href={`/library/?era=${e.era}`}>{n} writings from this period →</a> : null}
              {e.wiki ? <a href={e.wiki} rel="noopener" target="_blank">Further reading ↗</a> : null}
            </p>
          </article>
        </li>); })}
    </ol>
    <p class="cite-line" style="margin-top:12px"><span>Archived {longDate(hist.archived)} · Source: {hist.source_note}</span></p>
  </div>
</Base>
<style>
  .kick { margin: 0; font-size: 13px; color: var(--muted); text-transform: uppercase; letter-spacing: .08em; }
  .g-c { --c: var(--green); } .g-p { --c: var(--saffron-text); } .g-d { --c: #3b7f9a; } .g-e { --c: #7a4a8a; } .g-m { --c: #55605D; }
  .cp { list-style: none; margin: 0; padding: 0; position: relative; }
  .cp::before { content: ''; position: absolute; top: 6px; bottom: 6px; left: 150px; width: 3px; background: var(--green-line); border-radius: 2px; }
  .cp li { position: relative; display: grid; grid-template-columns: 138px 1fr; gap: 0 38px; padding-bottom: 22px; }
  .cp li::before { content: ''; position: absolute; left: 143px; top: 8px; width: 13px; height: 13px; border-radius: 50%; background: var(--surface); border: 4px solid var(--c); box-sizing: content-box; margin-left: -4px; }
  .cp-when { text-align: right; font: 600 15px var(--sans); color: var(--ink-2); padding-top: 4px; }
  .cp article { background: var(--surface); border: 1px solid var(--line); border-left: 4px solid var(--c); border-radius: var(--radius); padding: 16px 20px; }
  .cp h2 { font-size: 21px; margin: 0; } .cp h2 a { color: inherit; text-decoration: none; } .cp h2 a:hover { color: var(--green); }
  .cp-note { font: 400 13px var(--sans); color: var(--muted); margin-left: 8px; }
  .cp-place { margin: 2px 0 8px !important; font-size: 13px !important; color: var(--muted); letter-spacing: .02em; }
  .cp article p { margin: 0 0 8px; font-size: 15.5px; line-height: 1.6; }
  .cp-rulers { font-size: 14px !important; color: var(--ink-2); }
  .cp-links { display: flex; flex-wrap: wrap; gap: 6px 18px; font-size: 14px !important; margin: 4px 0 0 !important; } .cp-links a { font-weight: 500; }
  @media (max-width: 700px) {
    .cp::before { left: 8px; }
    .cp li { grid-template-columns: 1fr; padding-left: 32px; padding-bottom: 18px; }
    .cp li::before { left: 8px; top: 4px; }
    .cp-when { text-align: left; padding: 0 0 6px; font-size: 14px; }
  }
</style>
