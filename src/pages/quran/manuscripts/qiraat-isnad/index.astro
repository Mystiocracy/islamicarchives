    });
    nodes.forEach((n, i) => {
      const x = n.x, deg = n.a * 180 / Math.PI, left = Math.cos(n.a) < 0;
      const name = x.k === 'x' ? '→ ' + x.ref.replace(/^\d+ · /, '') : x.n, label = esc(name) + (x.d ? ` · ${esc(x.d.split(' · ')[0])}` : '');
      const r = x.k === 'n' ? 9 : x.k === 'i' ? 7 : x.k === 'x' ? 4 : 5;
      let t;
      if (!n.parent) t = `<text x="${n.px}" y="${n.py + 30}" text-anchor="middle">${esc(name)}</text>`;
      else if (n.kids.length && x.k === 't') t = '';
      else if (n.kids.length) t = `<text x="${n.px.toFixed(1)}" y="${(n.py - r - 6).toFixed(1)}" text-anchor="middle">${label}</text>`;
      else t = `<text transform="translate(${n.px.toFixed(1)},${n.py.toFixed(1)}) rotate(${(left ? deg + 180 : deg).toFixed(1)})" x="${left ? -10 : 10}" dy="0.32em" text-anchor="${left ? 'end' : 'start'}">${label}</text>`;
