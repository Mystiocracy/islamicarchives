    }
    const target = (i) => { const x = nodes[i].x; if (x.k !== 'x') return i; const j = nodes.findIndex((m) => m.x.n === x.ref && m.x.k !== 'x'); return j < 0 ? i : j; };
    host.addEventListener('click', (e) => { const g = e.target.closest('.rd-node'); if (g) pick(target(+g.dataset.i)); });
    host.addEventListener('keydown', (e) => { const g = e.target.closest('.rd-node'); if (g && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); pick(target(+g.dataset.i)); } });
    document.getElementById('rd-clear').addEventListener('click', () => { host.querySelectorAll('.on').forEach((e) => e.classList.remove('on')); sel.textContent = ''; });
    const frame = document.getElementById('rd-frame');
    draggable(frame);
    const apply = () => { svg.setAttribute('width', String(rdSize * rdScale)); svg.setAttribute('height', String(rdSize * rdScale)); };
    const fit = () => { rdScale = Math.min(1, (frame.clientWidth - 4) / rdSize); apply(); frame.scrollLeft = (frame.scrollWidth - frame.clientWidth) / 2; frame.scrollTop = 0; };
    document.getElementById('rd-in').addEventListener('click', () => { const cxp = (frame.scrollLeft + frame.clientWidth / 2) / (rdSize * rdScale), cyp = (frame.scrollTop + frame.clientHeight / 2) / (rdSize * rdScale); rdScale = Math.min(2, rdScale * 1.4); apply(); frame.scrollLeft = cxp * rdSize * rdScale - frame.clientWidth / 2; frame.scrollTop = cyp * rdSize * rdScale - frame.clientHeight / 2; });
    document.getElementById('rd-out').addEventListener('click', () => { rdScale = Math.max(0.2, rdScale / 1.4); apply(); });
    document.getElementById('rd-fit').addEventListener('click', fit);
    fit();
  }

  /* Imam by Imam */
  const P = D.chains.people;
  function findNode(x, name) { if (x.n === name) return x; for (const c of x.c || []) { const f = findNode(c, name); if (f) return f; } return null; }
  function strip(x, imamNo) {
    const c = (x.c || []).flatMap((y) => {
      if (y.k === 'i' && y.n === 'Khalaf b. Hishām' && imamNo === 6) return [{ ...y, also: 'rāwī of Ḥamza (also the 10th Imam)', c: (y.c || []).filter((z) => z.n === 'As rāwī of Ḥamza').flatMap((z) => z.c) }];
      if (y.k === 'i') return [];
      if (imamNo === 10 && y.n === 'As rāwī of Ḥamza') return [];
      return [strip(y, imamNo)];
    });
    return { ...x, c };
  }
  function boxHtml(x, toggle, extra) {
    const date = x.d ? `<span class="iq-d">${x.d === 'unknown' ? 'date unknown' : 'd. ' + esc(x.d)}</span>` : '';
    const also = x.also ? `<span class="iq-also">${esc(x.also)}</span>` : '';
    const inner = `<b>${esc(x.n)}</b>${date}${also}${extra || ''}`;
    const head = toggle ? `<button type="button" class="iq-h" aria-expanded="true">${inner}<span class="iq-cnt" aria-hidden="true">–</span></button>` : `<span class="iq-h">${inner}</span>`;
    const link = x.q ? `<a class="iq-wk" href="${wiki(x.q)}" rel="noopener" target="_blank">Wikipedia ↗</a>` : '';
    return `<div class="iq-box iq-${x.k}">${head}${link}</div>`;
  }
  function orgHtml(x) { const k = x.c || []; return `<li data-k="${x.k}">${boxHtml(x, k.length > 0, x.tag ? `<span class="dis">${esc(x.tag)}</span>` : '')}${k.length ? '<ul>' + k.map(orgHtml).join('') + '</ul>' : ''}</li>`; }
  function showImam(no) {
    const im = D.chains.imams.find((m) => m.no === no);
    const node = findNode(D.tree, im.node);
    const below = strip(node, no);
    const root = {};
    im.paths.forEach((x) => {
      const path = Array.isArray(x) ? x : x.p;
      let t = root;
      ['P', ...path].forEach((id) => { t[id] = t[id] || {}; t = t[id]; });
      const key = Array.isArray(x) ? 'IMAM' : 'IMAM:' + (x.tag || 'disputed');
      t[key] = {};
    });
    const name = im.no === 10 ? '10 · Khalaf al-ʿĀshir' : below.n;
    const people = (id) => { const p = P[id]; return { n: p[0], d: p[1], k: p[2] }; };
    function build(t) {
      return Object.entries(t).map(([id, sub]) => {
        if (id === 'IMAM' || id.startsWith('IMAM:')) return { n: name, d: below.d, k: 'i', tag: id.startsWith('IMAM:') ? id.slice(5) : '', c: [] };
        return { ...people(id), c: build(sub) };
      });
    }
    const tree = build(root)[0];
    const down = { ...below, n: name, also: undefined };
    document.getElementById('im-org').innerHTML = `<p class="im-cap">Every chain from the Prophet ﷺ to ${esc(name.replace(/^\d+ · /, ''))}</p><ul>` + orgHtml(tree) + `</ul><p class="im-cap">From ${esc(name.replace(/^\d+ · /, ''))} to the rāwīs and their ṭuruq</p><ul>` + orgHtml(down) + '</ul>';
    document.querySelectorAll('#im-pick button').forEach((b) => b.setAttribute('aria-pressed', String(+b.dataset.no === no)));
    requestAnimationFrame(() => center(document.getElementById('im-frame')));
  }
  const pick = document.getElementById('im-pick');
  pick.innerHTML = D.chains.imams.map((m) => `<button type="button" data-no="${m.no}">${esc(P[m.id][0])}</button>`).join('');
  pick.addEventListener('click', (e) => { const b = e.target.closest('button'); if (b) showImam(+b.dataset.no); });
  draggable(document.getElementById('im-frame'));
  showImam(5);

  /* table search */
  const q = document.getElementById('tb-q'), rows = [...document.querySelectorAll('#tb tbody tr')], cnt = document.getElementById('tb-count');
  const fold = (s) => s.normalize('NFD').replace(/[̀-ͯʿʾ‘’'ʿʾ]/g, '').toLowerCase();
  const txt = rows.map((r) => fold(r.textContent));
  q.addEventListener('input', () => { const v = fold(q.value.trim()); let n = 0; rows.forEach((r, i) => { const ok = !v || txt[i].includes(v); r.hidden = !ok; if (ok) n++; }); cnt.textContent = n + (n === 1 ? ' ṭarīq' : ' ṭuruq'); });

  /* tabs */
  const tabs = [...document.querySelectorAll('.iq-tabs [role=tab]')];
  function show(v, focus) {
    tabs.forEach((t) => { const on = t.dataset.v === v; t.setAttribute('aria-selected', String(on)); t.tabIndex = on ? 0 : -1; document.getElementById(t.getAttribute('aria-controls')).hidden = !on; if (on && focus) t.focus(); });
    if (v === 'radial' && !rdBuilt) buildRadial();
    if (v === 'tree') requestAnimationFrame(() => center(fr));
    if (v === 'imam') requestAnimationFrame(() => center(document.getElementById('im-frame')));
    try { history.replaceState(null, '', '#' + v); } catch (e) {}
  }
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => show(t.dataset.v));
    t.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') { const j = (i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length; show(tabs[j].dataset.v, true); } });
  });
  const h = location.hash.slice(1);
  if (tabs.some((t) => t.dataset.v === h)) show(h);
})();
</script>
