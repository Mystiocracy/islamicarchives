---
import Base from '../../../../layouts/Base.astro';
import QuranSubnav from '../../../../components/QuranSubnav.astro';
import { longDate, SITE } from '../../../../lib/quran';
import articleHtml from '../../../../data/first-century-article.html?raw';

const ARCHIVED = '2026-10-16';
const REVISED = '2026-10-18';
const TITLE = 'Manuscripts of the Qur’an Attributable to the First Century of the Hijra';
const SOURCE_TITLE = 'Concise List Of Arabic Manuscripts Of The Qur’ān Attributable To The First Century Hijra';
const SOURCE_URL = 'https://www.islamic-awareness.org/quran/text/mss/hijazi';
const HERE = `${SITE}/quran/manuscripts/first-century-manuscripts/`;
const cite = `Islamic Awareness. “${SOURCE_TITLE}.” First composed 14 June 2008, last updated 3 April 2019. ${SOURCE_URL}. Study notes archived ${longDate(ARCHIVED)}, revised ${longDate(REVISED)}, in Islamic Internet Archives, “Quranic manuscript catalogue”, ${HERE}.`;
---
<Base title={TITLE} description="Study notes on the Islamic Awareness article on Qur'an manuscripts from the first century of the hijra: how they are dated, radiocarbon results, how much of the text survives, key manuscripts and further reading." current="quran">
  <div class="wrap" style="padding-top:28px; padding-bottom:0">
    <QuranSubnav current="manuscripts" />
    <nav aria-label="Breadcrumb" class="muted" style="font-size:14px; margin:0 0 14px"><a href="/quran/manuscripts/">Quranic manuscript catalogue</a> › Article</nav>
  </div>
  <div class="ap-band" data-pagefind-body>
    <main class="ap">
      <p class="sub">Qur'anic Manuscripts</p>
      <h1 data-pagefind-meta="title">Manuscripts of the Qur'an Attributable to the First Century of the Hijra</h1>
      <p class="sub">Study notes and an index of key manuscripts, from the article by Islamic Awareness. Archived {longDate(ARCHIVED)}; revised {longDate(REVISED)}.</p>
      <div class="article" set:html={articleHtml} />
      <footer class="ap-foot">
        <p><strong>Archived</strong> {longDate(ARCHIVED)}. <strong>How to cite:</strong> {cite}</p>
        <p>Summary and index prepared from <em>{SOURCE_TITLE}</em>, © Islamic Awareness. All credit for the underlying research and data belongs to them. Figures were checked against the original on {longDate(REVISED)}; please consult it before relying on them.</p>
      </footer>
    </main>
  </div>
</Base>
<style is:global>
  /* styled to match the standalone study-guide page: cream ground, Georgia serif, centred 880px column */
  .ap-band { background: #faf7f0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .ap { max-width: 880px; margin: 0 auto; padding: 24px 18px 70px; color: #222; font: 17px/1.65 Georgia, 'Times New Roman', serif; }
  .ap h1 { font: 700 1.9rem/1.25 Georgia, 'Times New Roman', serif; margin: 0.3em 0 0.2em; color: #222; }
  .ap .sub { color: #666; font-style: italic; margin: 0 0 1em; }
  .ap h2 { font: 700 1.3rem/1.3 Georgia, 'Times New Roman', serif; margin: 2em 0 0.5em; border-bottom: 1px solid #d8d2c2; padding-bottom: 0.2em; color: #1d5c4a; scroll-margin-top: 90px; }
  .ap h3 { font: 700 1.05rem/1.3 Georgia, 'Times New Roman', serif; margin: 1.4em 0 0.3em; color: #222; }
  .ap p { margin: 1em 0; }
  .ap a { color: #1d5c4a; }
  .ap ul, .ap ol { padding-left: 1.2em; }
  .ap li { margin: 0.25em 0; }
  .ap .a-credit { background: #fff; border: 1px solid #d8d2c2; border-left: 5px solid #1d5c4a; padding: 14px 18px; margin: 18px 0; font-size: 0.95rem; }
  .ap .a-credit p { margin: 0.3em 0; }
  .ap .a-note { background: #fff; border: 1px dashed #d8d2c2; padding: 10px 14px; font-size: 0.92rem; color: #666; margin: 1em 0; }
  .ap .a-toc { background: #fff; border: 1px solid #d8d2c2; padding: 10px 18px; font-size: 0.95rem; }
  .ap .a-toc ol { margin: 0.3em 0; padding-left: 1.3em; }
  .ap .a-scroll { overflow-x: auto; }
  .ap table { border-collapse: collapse; width: 100%; font-size: 0.88rem; background: #fff; }
  .ap th, .ap td { border: 1px solid #d8d2c2; padding: 6px 8px; vertical-align: top; text-align: left; }
  .ap th { background: rgba(29, 92, 74, 0.12); }
  .ap caption { text-align: left; font-size: 0.88rem; margin: 0.5em 0; color: #222; }
  .ap-foot { margin-top: 3em; font-size: 0.88rem; color: #666; border-top: 1px solid #d8d2c2; padding-top: 1em; overflow-wrap: anywhere; }
  .ap-foot strong { color: #222; }
  .ap-foot p { margin: 0.6em 0; }
</style>
