---
import Base from '../../layouts/Base.astro';
import HistoryTreeNode from '../../components/HistoryTreeNode.astro';
import hist from '../../data/history.json';
import { longDate } from '../../lib/quran';
import { allWorks, allEras, eraOf } from '../../lib/site';
import { entries, groups, treeDef, entryId, slug, splitCountry, isCountryLike, countryIndex } from '../../lib/history';

const eras = await allEras();
const works = await allWorks();
const perEra = new Map<string, number>();
for (const w of works) { const e = eraOf(w.data.year, eras); if (e) perEra.set(e.id, (perEra.get(e.id) || 0) + 1); }
const groupKeys = Object.keys(groups);
const countries = countryIndex();
const spanOf = (c: (typeof countries)[number]) => {
  const first = c.periods[0].entry; const last = c.periods[c.periods.length - 1].entry;
  return `${first.when.split('–')[0].trim()} – ${last.to >= 9999 ? 'today' : last.to}`;
};
// Compact data for the in-page country drawer.
const drawerData = Object.fromEntries(countries.map((c) => [c.slug, {
  name: c.name, span: spanOf(c),
  periods: c.periods.map((p) => ({ id: entryId(p.entry.name), name: p.entry.name, when: p.entry.when, group: p.entry.group, note: p.note, wiki: p.entry.wiki || '',
    rulers: (p.entry.rulers || []).slice(0, 3).map((r) => `${r.name} (${r.when})`) })),
}]));
---
<Base title={hist.title} description={hist.intro} current="history">
  <div class="wrap" style="padding-top:40px; padding-bottom:56px; display:flex; flex-direction:column; gap:26px">
    <div>
      <h1 style="font-size:40px; margin:0 0 0.3em">{hist.title}</h1>
      <p class="muted" style="margin:0; font-size:17px; max-width:760px">{hist.intro}</p>
    </div>

    <div class="h-top">
      <div class="h-tabs" role="tablist" aria-label="View">
        <button type="button" class="on" data-v="tree" role="tab" aria-selected="true">Tree</button>
        <button type="button" data-v="line" role="tab" aria-selected="false">Timeline</button>
        <button type="button" data-v="countries" role="tab" aria-selected="false">Countries</button>
      </div>
      <div class="h-legend" aria-label="Key">{groupKeys.map((k) => <span><i class={`hd g-${k}`}></i>{groups[k]}</span>)}</div>
    </div>

    <!-- ───── Tree ───── -->
    <section id="v-tree" class="h-view" aria-label="Family tree of states">
      <div class="h-hint">
        <p class="muted">Each state sits below the power it grew out of or replaced. <b>Tap a tile</b> to open its branches — the major rulers, and the countries that stand on that ground today. Tap a country to follow its story through every period. Scroll sideways on small screens.</p>
        <div class="h-hint-btns"><button type="button" class="btn-sm" id="t-expand">Open all</button><button type="button" class="btn-sm" id="t-collapse">Close all</button></div>
      </div>
      <div class="h-tree-scroll">
        <ul class="tree"><HistoryTreeNode node={treeDef} perEra={perEra} /></ul>
      </div>
    </section>

    <!-- ───── Countries ───── -->
    <section id="v-countries" class="h-view" hidden aria-label="Countries">
      <p class="muted" style="margin:0 0 14px; font-size:14px">The modern states that stand on the ground of these empires and caliphates. Open a country to see every period it passed through, from the first community to today.</p>
      <div class="c-grid">
        {countries.map((c) => (
          <button type="button" class="c-card" data-country={c.slug}>
            <b>{c.name}</b>
            <span class="c-span">{spanOf(c)}</span>
            <span class="c-dots" aria-hidden="true">{c.periods.map((p) => <i class={`g-${p.entry.group}`} title={p.entry.name}></i>)}</span>
            <span class="c-n">{c.periods.length} periods</span>
          </button>
        ))}
      </div>
    </section>

    <!-- ───── Timeline ───── -->
    <ol class="h-line h-view" id="v-line" hidden>
      {entries.map((e) => {
        const n = e.era ? perEra.get(e.era) : 0;
        return (
          <li class={`h-ev g-${e.group}`} id={entryId(e.name)}>
            <div class="h-date">{e.when}</div>
            <article class="h-card">
              <h2>{e.name}</h2>
              <p class="h-place">{e.place}</p>
              <p>{e.text}</p>
              {e.countries && e.countries.length > 0 && (
                <div class="h-countries"><span class="h-sub">Today's countries</span>
                  <div class="chips">{e.countries.map((raw: string) => { const c = splitCountry(raw); return isCountryLike(raw)
                    ? <button type="button" class="chip" data-country={slug(c.name)}>{c.name}{c.note ? <small> · {c.note}</small> : null}</button>
                    : <span class="chip chip-note">{raw}</span>; })}</div></div>
              )}
              {e.rulers && e.rulers.length > 0 && (
                <div class="h-rulers"><span class="h-sub">Major rulers</span>
                  <ol>{e.rulers.map((r) => <li><span class="r-when">{r.when}</span><span class="r-name"><b>{r.name}</b> <em>{r.role}</em></span></li>)}</ol></div>
              )}
              <p class="h-links">
                {e.era && n ? <a href={`/library/?era=${e.era}`}>{n} writings from this period →</a> : null}
                {e.wiki ? <a href={e.wiki} rel="noopener" target="_blank">Further reading ↗</a> : null}
              </p>
            </article>
          </li>
        );
      })}
    </ol>

    <p class="cite-line"><span>Archived {longDate(hist.archived)} · Source: {hist.source_note}</span></p>
  </div>

  <!-- ───── Country drawer ───── -->
  <div id="c-shade" class="c-shade" hidden></div>
  <aside id="c-drawer" class="c-drawer" hidden aria-label="Country history" role="dialog" aria-modal="true">
    <header>
      <div><p class="c-kicker">History of</p><h2 id="cd-name">Country</h2><p class="c-kicker" id="cd-span"></p></div>
      <button type="button" class="c-close" id="cd-close" aria-label="Close">×</button>
    </header>
    <ol class="c-periods" id="cd-list"></ol>
    <footer><a id="cd-page" href="#">Open full country page →</a></footer>
  </aside>
  <script type="application/json" id="c-data" set:html={JSON.stringify(drawerData)} />
</Base>

<style>
  .h-top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 24px; }
  .h-legend { display: flex; flex-wrap: wrap; gap: 8px 18px; font: 13px var(--sans); color: var(--muted); }
  .hd { display: inline-block; width: 12px; height: 12px; border-radius: 50%; margin-right: 6px; vertical-align: -1px; border: 4px solid var(--c); background: var(--surface); }
  .h-tabs { display: inline-flex; border: 1px solid var(--line); border-radius: 999px; overflow: hidden; background: var(--surface); }
  .h-tabs button { font: inherit; font-size: 14px; padding: 7px 20px; background: transparent; color: inherit; border: 0; cursor: pointer; transition: background .15s; }
  .h-tabs button:hover { background: var(--green-tint); }
  .h-tabs button.on { background: var(--green); color: #fff; }
  .h-hint { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-start; gap: 10px 24px; margin-bottom: 14px; }
  .h-hint p { margin: 0; font-size: 14px; max-width: 720px; }
  .h-hint-btns { display: flex; gap: 8px; }
  .btn-sm { font: inherit; font-size: 13px; padding: 5px 14px; border: 1px solid var(--line); border-radius: 999px; background: var(--surface); cursor: pointer; }
  .btn-sm:hover { border-color: var(--green); color: var(--green); }

  /* timeline */
  .h-line { list-style: none; margin: 0; padding: 0; position: relative; }
  .h-line:before { content: ''; position: absolute; top: 6px; bottom: 6px; left: 150px; width: 3px; background: var(--green-line); border-radius: 2px; }
  .h-ev { position: relative; display: grid; grid-template-columns: 138px 1fr; gap: 0 38px; padding-bottom: 22px; scroll-margin-top: 90px; }
  .h-ev:before { content: ''; position: absolute; left: 143px; top: 8px; width: 13px; height: 13px; border-radius: 50%; background: var(--surface); border: 4px solid var(--c); box-sizing: content-box; margin-left: -4px; }
  .h-date { text-align: right; font: 600 15px var(--sans); color: var(--ink-2); padding-top: 4px; }
  .h-card { background: var(--surface); border: 1px solid var(--line); border-left: 4px solid var(--c); border-radius: var(--radius); padding: 16px 20px; }
  .h-card h2 { font-size: 21px; margin: 0; }
  .h-place { margin: 2px 0 8px; font-size: 13px; color: var(--muted); letter-spacing: 0.02em; }
  .h-card p { margin: 0 0 8px; font-size: 15.5px; line-height: 1.6; }
  .h-links { display: flex; flex-wrap: wrap; gap: 6px 18px; font-size: 14px; margin: 4px 0 0 !important; }
  .h-links a { font-weight: 500; }
  .h-rulers ol { list-style: none; margin: 0; padding: 0 0 0 14px; border-left: 2px solid var(--c); }
  .h-rulers li { position: relative; display: grid; grid-template-columns: 150px 1fr; gap: 10px; font-size: 14.5px; padding: 3px 0; }
  .h-rulers li::before { content: ''; position: absolute; left: -19px; top: 11px; width: 8px; height: 8px; border-radius: 50%; background: var(--c); }
  .r-when { color: var(--muted); font-variant-numeric: tabular-nums; }
  .r-name em { color: var(--muted); font-style: normal; font-size: 13px; }
  .h-ev.flash .h-card { animation: flash 1.6s ease-out; }
  @keyframes flash { 0% { box-shadow: 0 0 0 4px var(--saffron); } 100% { box-shadow: 0 0 0 0 transparent; } }
  @media (max-width: 700px) {
    .h-line:before { left: 8px; }
    .h-ev { grid-template-columns: 1fr; padding-left: 32px; padding-bottom: 18px; }
    .h-ev:before { left: 8px; top: 4px; }
    .h-date { text-align: left; padding: 0 0 6px; font-size: 14px; }
    .h-rulers li { grid-template-columns: 1fr; gap: 0; }
  }

  /* countries grid */
  .c-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 12px; }
  .c-card { font: inherit; text-align: left; display: flex; flex-direction: column; gap: 4px; padding: 14px 16px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); cursor: pointer; transition: transform .15s, box-shadow .15s, border-color .15s; }
  .c-card:hover { transform: translateY(-2px); box-shadow: 0 6px 18px rgba(20,32,30,.10); border-color: var(--green-line); }
  .c-card b { font-family: var(--serif); font-size: 18px; }
  .c-span, .c-n { font-size: 12.5px; color: var(--muted); }
  .c-dots { display: flex; gap: 3px; margin: 4px 0 2px; }
  .c-dots i { width: 10px; height: 10px; border-radius: 50%; background: var(--c); }
</style>

<style is:global>
  .g-c { --c: var(--green); } .g-p { --c: var(--saffron-text); } .g-d { --c: #3b7f9a; } .g-e { --c: #7a4a8a; } .g-m { --c: #55605D; }
  .h-sub { display: block; font-size: 11.5px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin: 10px 0 6px; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .chip { font: inherit; font-size: 13px; line-height: 1.3; padding: 3px 11px; border: 1px solid var(--line); border-radius: 999px; background: var(--surface); color: var(--ink); cursor: pointer; transition: background .15s, border-color .15s, color .15s; }
  .chip small { color: var(--muted); font-size: 11.5px; }
  button.chip:hover { background: var(--green-tint); border-color: var(--green); color: var(--green-dark); }
  .chip-note { cursor: default; color: var(--muted); }

  /* tree */
  .h-tree-scroll { overflow-x: auto; padding: 4px 4px 16px; }
  .tree, .tree ul { list-style: none; margin: 0; padding: 0; }
  .tree { display: flex; justify-content: center; min-width: max-content; }
  .tree ul { display: flex; justify-content: center; padding-top: 24px; position: relative; }
  .tree ul > li { display: flex; flex-direction: column; align-items: center; position: relative; padding: 24px 8px 0; }
  .tree > li { padding-top: 0; }
  .tree ul > li::before, .tree ul > li::after { content: ''; position: absolute; top: 0; width: 50%; height: 24px; border-top: 2px solid var(--green-line); }
  .tree ul > li::before { right: 50%; } .tree ul > li::after { left: 50%; border-left: 2px solid var(--green-line); }
  .tree > li::before, .tree > li::after { display: none; }
  .tree ul > li:only-child::before, .tree ul > li:only-child::after { display: none; }
  .tree ul > li:only-child { padding-top: 0; }
  .tree ul > li:first-child::before, .tree ul > li:last-child::after { border: 0; }
  .tree ul > li:last-child::before { border-right: 2px solid var(--green-line); border-radius: 0 8px 0 0; }
  .tree ul > li:first-child::after { border-radius: 8px 0 0 0; }
  .tree ul::before { content: ''; position: absolute; top: 0; left: 50%; height: 24px; border-left: 2px solid var(--green-line); }
  .tnode { display: flex; flex-direction: column; align-items: center; }
  .tn { position: relative; display: block; width: 164px; padding: 10px 26px 9px 12px; text-align: center; font: inherit; border: 1px solid var(--line); border-top: 4px solid var(--c); border-radius: var(--radius); background: var(--surface); color: inherit; line-height: 1.25; cursor: pointer; transition: transform .15s, box-shadow .15s, border-color .15s; }
  .tn b { display: block; font-family: var(--serif); font-size: 14.5px; } .tn small { color: var(--muted); font-size: 12px; }
  .tn:hover { transform: translateY(-2px); box-shadow: 0 6px 18px rgba(20,32,30,.12); }
  .tn-plus { position: absolute; right: 8px; top: 50%; width: 16px; height: 16px; margin-top: -8px; border-radius: 50%; border: 1.5px solid var(--c); }
  .tn-plus::before, .tn-plus::after { content: ''; position: absolute; background: var(--c); left: 50%; top: 50%; transform: translate(-50%, -50%); transition: transform .2s; }
  .tn-plus::before { width: 8px; height: 1.5px; } .tn-plus::after { width: 1.5px; height: 8px; }
  .tn[aria-expanded="true"] { box-shadow: 0 0 0 3px color-mix(in srgb, var(--c) 30%, transparent); }
  .tn[aria-expanded="true"] .tn-plus::after { transform: translate(-50%, -50%) rotate(90deg); }
  .tb { width: 300px; margin-top: 8px; }
  .tb-in { border: 1px solid var(--line); border-left: 3px solid var(--c); border-radius: var(--radius); background: var(--surface); padding: 12px 14px; text-align: left; font-size: 14px; animation: tb-in .22s ease-out; box-shadow: 0 8px 24px rgba(20,32,30,.08); }
  @keyframes tb-in { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: none; } }
  .tb-place { margin: 0 0 4px; font-size: 12.5px; color: var(--muted); letter-spacing: .02em; }
  .tb-text { margin: 0; line-height: 1.5; }
  .rtree { list-style: none; margin: 0; padding: 0 0 0 16px; border-left: 2px solid var(--c); }
  .rtree li { position: relative; display: grid; grid-template-columns: auto 1fr; gap: 0 8px; padding: 2px 0; font-size: 13.5px; }
  .rtree li::before { content: ''; position: absolute; left: -21px; top: 9px; width: 8px; height: 8px; border-radius: 50%; background: var(--c); }
  .rt-when { grid-column: 1 / -1; color: var(--muted); font-size: 12px; font-variant-numeric: tabular-nums; }
  .rt-name { font-weight: 600; } .rt-role { color: var(--muted); font-size: 12.5px; align-self: baseline; }
  .tb-links { display: flex; flex-wrap: wrap; gap: 4px 14px; margin: 12px 0 0; font-size: 13px; }
  .tb-links a { font-weight: 500; }

  /* drawer */
  .c-shade { position: fixed; inset: 0; background: rgba(20,32,30,.35); z-index: 60; animation: fade .2s; }
  @keyframes fade { from { opacity: 0; } }
  .c-drawer { position: fixed; top: 0; right: 0; bottom: 0; width: min(440px, 100%); background: var(--ground); z-index: 61; display: flex; flex-direction: column; box-shadow: -8px 0 30px rgba(20,32,30,.2); animation: slide .25s ease-out; }
  @keyframes slide { from { transform: translateX(40px); opacity: 0; } }
  .c-drawer header { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; padding: 22px 22px 14px; border-bottom: 1px solid var(--line); background: var(--surface); }
  .c-drawer h2 { font-size: 28px; margin: 0; }
  .c-kicker { margin: 0; font-size: 12.5px; color: var(--muted); text-transform: uppercase; letter-spacing: .08em; }
  .c-close { font: inherit; font-size: 26px; line-height: 1; width: 36px; height: 36px; border-radius: 50%; border: 1px solid var(--line); background: var(--surface); cursor: pointer; }
  .c-close:hover { background: var(--green-tint); }
  .c-periods { list-style: none; margin: 0; padding: 18px 22px 18px 42px; overflow-y: auto; flex: 1; position: relative; }
  .c-periods::before { content: ''; position: absolute; left: 28px; top: 22px; bottom: 22px; width: 3px; background: var(--green-line); border-radius: 2px; }
  .c-periods li { position: relative; padding: 0 0 16px; }
  .c-periods li::before { content: ''; position: absolute; left: -19px; top: 5px; width: 11px; height: 11px; border-radius: 50%; background: var(--surface); border: 3px solid var(--c); }
  .c-periods .cp-when { font-size: 12.5px; color: var(--muted); font-variant-numeric: tabular-nums; }
  .c-periods .cp-name { font: 600 16px var(--serif); background: none; border: 0; padding: 0; color: var(--ink); cursor: pointer; text-align: left; }
  .c-periods .cp-name:hover { color: var(--green); text-decoration: underline; }
  .c-periods .cp-note { font-size: 12.5px; color: var(--muted); margin-left: 6px; }
  .c-periods .cp-rulers { font-size: 13px; color: var(--ink-2); margin: 2px 0 0; }
  .c-periods .cp-wiki { font-size: 12.5px; margin-left: 8px; }
  .c-drawer footer { padding: 14px 22px; border-top: 1px solid var(--line); background: var(--surface); font-size: 14px; font-weight: 500; }
  @media (max-width: 700px) {
    .c-drawer { top: auto; height: 86vh; width: 100%; border-radius: 16px 16px 0 0; animation: up .25s ease-out; }
    @keyframes up { from { transform: translateY(40px); opacity: 0; } }
  }
</style>

<script is:inline>
(function () {
  var views = { tree: 'v-tree', line: 'v-line', countries: 'v-countries' };
  function showView(v) {
    Object.keys(views).forEach(function (k) { document.getElementById(views[k]).hidden = k !== v; });
    document.querySelectorAll('.h-tabs button').forEach(function (x) { var on = x.dataset.v === v; x.classList.toggle('on', on); x.setAttribute('aria-selected', on); });
    try { history.replaceState(null, '', '#' + (v === 'tree' ? '' : v)); } catch (e) {}
  }
  document.querySelectorAll('.h-tabs button').forEach(function (b) { b.addEventListener('click', function () { showView(b.dataset.v); }); });

  // Tree tiles: expand / collapse branches (never navigate).
  function setTile(btn, open) { btn.setAttribute('aria-expanded', open); document.getElementById(btn.getAttribute('aria-controls')).hidden = !open; }
  document.querySelectorAll('.tn').forEach(function (btn) {
    btn.addEventListener('click', function () { setTile(btn, btn.getAttribute('aria-expanded') !== 'true'); });
  });
  document.getElementById('t-expand').addEventListener('click', function () { document.querySelectorAll('.tn').forEach(function (b) { setTile(b, true); }); });
  document.getElementById('t-collapse').addEventListener('click', function () { document.querySelectorAll('.tn').forEach(function (b) { setTile(b, false); }); });

  function gotoTimeline(id) {
    showView('line'); closeDrawer();
    var el = document.getElementById(id); if (!el) return;
    el.scrollIntoView({ behavior: 'smooth', block: 'start' });
    el.classList.remove('flash'); void el.offsetWidth; el.classList.add('flash');
  }
  function gotoTile(id) {
    showView('tree'); closeDrawer();
    var btn = document.querySelector('.tn[data-id="' + id + '"]'); if (!btn) return;
    setTile(btn, true);
    btn.scrollIntoView({ behavior: 'smooth', block: 'center', inline: 'center' });
  }
  document.addEventListener('click', function (ev) {
    var a = ev.target.closest && ev.target.closest('[data-goto]'); if (!a) return;
    ev.preventDefault(); gotoTimeline(a.dataset.goto);
  });

  // Country drawer.
  var data = JSON.parse(document.getElementById('c-data').textContent || '{}');
  var drawer = document.getElementById('c-drawer'), shade = document.getElementById('c-shade'), lastFocus = null;
  function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
  function openDrawer(slug) {
    var c = data[slug]; if (!c) return;
    lastFocus = document.activeElement;
    document.getElementById('cd-name').textContent = c.name;
    document.getElementById('cd-span').textContent = c.periods.length + ' periods · ' + c.span;
    document.getElementById('cd-page').href = '/history/countries/' + slug + '/';
    document.getElementById('cd-list').innerHTML = c.periods.map(function (p) {
      return '<li class="g-' + p.group + '"><div class="cp-when">' + esc(p.when) + '</div>' +
        '<button type="button" class="cp-name" data-period="' + esc(p.id) + '">' + esc(p.name) + '</button>' +
        (p.note ? '<span class="cp-note">' + esc(p.note) + '</span>' : '') +
        (p.rulers.length ? '<p class="cp-rulers">' + esc(p.rulers.join(' · ')) + '</p>' : '') +
        (p.wiki ? '<a class="cp-wiki" href="' + esc(p.wiki) + '" target="_blank" rel="noopener">Further reading ↗</a>' : '') + '</li>';
    }).join('');
    drawer.hidden = false; shade.hidden = false; document.body.style.overflow = 'hidden';
    document.getElementById('cd-close').focus();
  }
  function closeDrawer() {
    if (drawer.hidden) return;
    drawer.hidden = true; shade.hidden = true; document.body.style.overflow = '';
    if (lastFocus && lastFocus.focus) lastFocus.focus();
  }
  document.addEventListener('click', function (ev) {
    var t = ev.target.closest && ev.target.closest('[data-country]'); if (t) { openDrawer(t.dataset.country); return; }
    var p = ev.target.closest && ev.target.closest('[data-period]');
    if (p) { if (document.getElementById('v-tree').hidden) gotoTimeline(p.dataset.period); else gotoTile(p.dataset.period); }
  });
  document.getElementById('cd-close').addEventListener('click', closeDrawer);
  shade.addEventListener('click', closeDrawer);
  document.addEventListener('keydown', function (ev) { if (ev.key === 'Escape') closeDrawer(); });

  // Deep links: #line, #countries, #country=egypt, #h-<entry>
  var h = location.hash.slice(1);
  if (h === 'line' || h === 'countries') showView(h);
  else if (h.indexOf('country=') === 0) { showView('countries'); openDrawer(h.slice(8)); }
  else if (h.indexOf('h-') === 0) gotoTile(h);
})();
</script>
