---
import Base from '../layouts/Base.astro';
import { allWorks, allAuthors, allSubjects, allEras, eraSpan } from '../lib/site';

const works = await allWorks();
const authors = await allAuthors();
const subjects = await allSubjects();
const eras = await allEras();
const count = new Map<string, number>();
for (const w of works) count.set(w.data.author.id, (count.get(w.data.author.id) || 0) + 1);
const tickerAuthors = authors.filter((a) => (count.get(a.id) || 0) > 0);
---
<Base current="home">
  <section style="background: var(--green-dark); color: #fff">
    <div class="wrap hero" style="padding-top: 44px; padding-bottom: 48px; display: flex; flex-direction: column; gap: 16px">
      <h1 class="hero-h1" style="font-weight:700; font-size: clamp(32px, 4vw, 52px); line-height:1.08">The writings of modern Muslim thinkers.</h1>
      <p class="hero-lede" style="margin:0; font-size:19px; line-height:1.55; color:#D7E3DF">Books, essays and articles from the 19th century to today. Search the full text, read online, download in the format you need, or send a work straight to your Kindle or inbox.</p>
      <form class="hero-search" action="/library/" method="get" role="search" style="display:flex; flex-wrap:wrap; gap:10px; margin-top:4px">
        <label for="q" class="sr-only">Search the archive</label>
        <input id="q" name="q" type="search" data-suggest placeholder="Search authors, titles, subjects or words in the text" style="flex:1 1 420px; min-height:54px; font-size:17px; border:0; min-width:0">
        <button class="btn btn-saffron" style="min-height:54px; padding:0 28px; font-size:17px" aria-label="Search"><svg class="only-mobile" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg><span class="hide-mobile">Search</span></button>
      </form>
    </div>
  </section>

  <div class="wrap">
    <section class="section">
      <div class="feature-tiles" style="display:grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap:18px">
        {[
          ['Search every word', 'Full-text search across hosted works, with filters for author, subject, era, language and type.'],
          ['Download any format', 'EPUB, PDF, Word and plain text, with linked footnotes and a table of contents. EPUB works on Kindle too.'],
          ['Send to Kindle or email', 'Save your Kindle address once on this device and send any hosted work to your Kindle or inbox in one click.'],
        ].map(([h, p]) => (
          <div class="card" style="padding:24px; display:flex; flex-direction:column; gap:10px">
            <h2 style="font-size:21px">{h}</h2>
            <p class="muted" style="margin:0">{p}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="section">
      <a href="/quran/" class="card" style="display:flex; flex-wrap:wrap; align-items:center; gap:16px 28px; padding:24px 28px; text-decoration:none; color:var(--ink)">
        <span lang="ar" dir="rtl" style="font-family:'Noto Naskh Arabic', serif; font-size:34px; color:var(--saffron-text)">المعجم</span>
        <span style="flex:1 1 360px; display:flex; flex-direction:column; gap:6px">
          <span style="font-family:var(--serif); font-weight:600; font-size:24px">Quran Word Corpus</span>
          <span class="muted">Read the Quran word by word, with the grammar and root of every word, a dictionary of roots, search in Arabic and English, a table of verbs and a concordance.</span>
        </span>
        <span class="btn btn-primary">Open the Quran tool →</span>
      </a>
    </section>

    <section class="section">
      <div class="section-head"><h2>Featured authors</h2><a href="/authors/" style="font-weight:500">All authors A–Z →</a></div>
      <div class="ticker" data-ticker data-speed="40">
        <div class="ticker-track">
          {tickerAuthors.map((a) => <a class="chip" href={`/authors/${a.id}/`}>{a.data.name}</a>)}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="section-head"><h2>Browse by subject</h2><a href="/subjects/" style="font-weight:500">All subjects →</a></div>
      <div class="ticker" data-ticker data-speed="32">
        <div class="ticker-track">
          {subjects.map((s) => <a class="chip" href={`/subjects/${s.id}/`}>{s.data.name}</a>)}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="section-head"><h2>From the archive</h2><button type="button" class="btn btn-quiet" id="pick-again" style="font-weight:500">Show others ↻</button></div>
      <div class="card" id="random-works" aria-live="polite"></div>
    </section>

    <section class="section" id="eras">
      <div class="section-head"><h2>Browse by era</h2></div>
      <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); border-top:3px solid var(--green)">
        {eras.map((e) => (
          <a href={`/library/?era=${e.id}`} style="text-decoration:none; color:var(--ink); padding:18px 18px 18px 0; display:flex; flex-direction:column; gap:6px">
            <span style="width:14px; height:14px; border-radius:50%; background:var(--saffron); margin-top:-27px; border:3px solid var(--ground)"></span>
            <span style="font-size:14px; font-weight:600; color:var(--saffron-text)">{eraSpan(e.data)}</span>
            <span style="font-family:var(--serif); font-weight:600; font-size:18px">{e.data.name}</span>
          </a>
        ))}
      </div>
    </section>
  </div>
<script is:inline>
  (function () {
    function shuffle(a) { for (var i = a.length - 1; i > 0; i--) { var j = Math.floor(Math.random() * (i + 1)); var t = a[i]; a[i] = a[j]; a[j] = t; } return a; }
    var still = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Tickers: names in random order, scrolling for ever; each name that leaves on the left
    // is replaced on the right by a random name not already showing, so there is never a fixed sequence.
    document.querySelectorAll('[data-ticker]').forEach(function (box) {
      var track = box.querySelector('.ticker-track');
      var pool = shuffle(Array.prototype.slice.call(track.children));
      pool.forEach(function (el) { el.remove(); });
      if (still) { pool.forEach(function (el) { track.appendChild(el); }); box.classList.add('ticker-still'); return; }
      var shown = [], waiting = pool.slice();
      function next() {
        if (!waiting.length) waiting = shuffle(pool.filter(function (el) { return shown.indexOf(el) < 0; }));
        var el = waiting.pop();
        if (!el) return pool[Math.floor(Math.random() * pool.length)].cloneNode(true);  // short lists: repeat a name
        if (shown.indexOf(el) >= 0) el = el.cloneNode(true);
        return el;
      }
      function fill() {
        while (track.scrollWidth < box.clientWidth * 2 && shown.length < pool.length * 3) {
          var el = next(); track.appendChild(el); shown.push(el);
        }
      }
      fill();
      var x = 0, last = 0, paused = false, speed = +box.dataset.speed || 36;
      box.addEventListener('mouseenter', function () { paused = true; });
      box.addEventListener('mouseleave', function () { paused = false; });
      box.addEventListener('focusin', function () { paused = true; });
      box.addEventListener('focusout', function () { paused = false; });
      function step(t) {
        var dt = last ? Math.min(t - last, 100) / 1000 : 0; last = t;
        if (!paused && !document.hidden) x -= speed * dt;
        var first = track.firstElementChild;
        if (first) {
          var w = first.getBoundingClientRect().width + parseFloat(getComputedStyle(track).columnGap || 10);
          if (-x >= w) { x += w; first.remove(); shown.splice(shown.indexOf(first), 1); fill(); }
        }
        track.style.transform = 'translateX(' + x + 'px)';
        requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
      window.addEventListener('resize', fill);
    });

    // From the archive: five random works on every visit.
    var box = document.getElementById('random-works'), again = document.getElementById('pick-again'), works = null;
    function esc(t) { var d = document.createElement('div'); d.textContent = t == null ? '' : String(t); return d.innerHTML; }
    function draw() {
      if (!works) return;
      box.innerHTML = shuffle(works.slice()).slice(0, 5).map(function (w) {
        var meta = [w[4], w[5]].filter(Boolean).join(' · ');
        return '<article class="work-row"><div class="main">' +
          (meta ? '<div><span class="tag">' + esc((w[4] || '').toUpperCase()) + '</span>' + (w[5] ? ' <span class="muted" style="font-size:13px">' + esc(w[5]) + '</span>' : '') + '</div>' : '') +
          '<a class="title" href="' + esc(w[1]) + '">' + esc(w[0]) + '</a>' +
          (w[3] ? '<span style="font-weight:500; font-size:15px; color:var(--ink-2)">' + esc(w[3]) + '</span>' : '') +
          '</div></article>';
      }).join('');
    }
    fetch('/search-index.json').then(function (r) { return r.json(); }).then(function (d) { works = d.w; draw(); })
      .catch(function () { box.innerHTML = '<p class="muted" style="padding:16px 20px; margin:0"><a href="/library/">Browse the whole library →</a></p>'; });
    again.addEventListener('click', draw);
  })();
</script>
</Base>
