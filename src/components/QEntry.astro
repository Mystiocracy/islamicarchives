---
import { longDate } from '../lib/quran';
import { searchText } from '../lib/site';
interface Props { e: any; cite: string; pidx?: number; extra?: string; linkLabel?: string; authorHref?: string; works?: number }
const { e, cite, pidx = 0, extra = '', linkLabel, authorHref, works = 0 } = Astro.props;
const meta = [e.institution || e.location || e.affiliation].filter(Boolean).join('');
const text = searchText([e.name, e.nameNative, e.institution, e.location, e.affiliation, e.dateNote, e.script, e.period, e.kind, e.source, e.description, extra].filter(Boolean).join(' '));
---
<article class="work-row q-entry" id={e.id} data-q-item data-title={e.name.toLowerCase()} data-text={text} data-kind={e.kind} data-period={e.period || ''} data-source={e.source === 'Islamic Awareness' ? 'Islamic Awareness' : 'Other'} data-pidx={pidx}>
  <div class="main">
    <div style="display:flex; flex-wrap:wrap; gap:8px; align-items:center">
      <span class="tag">{e.kind.toUpperCase()}</span>
      {e.period && e.period !== 'Not dated or not applicable' && <span class="tag tag-green">{e.period}</span>}
      {works > 0 && <span class="tag tag-green">{works} {works === 1 ? 'work' : 'works'} listed</span>}
    </div>
    <a class="title" href={authorHref || `#${e.id}`}>{e.name}{e.nameNative && <span dir="rtl" lang="ar" style="font-family:'Noto Naskh Arabic',serif; margin-left:10px">{e.nameNative}</span>}</a>
    {meta && <span class="muted" style="font-size:14px">{meta}</span>}
    {e.dateNote && <span class="muted" style="font-size:13px">{e.dateNote}{e.script ? ' · ' + e.script : ''}</span>}
    <p class="muted" style="margin:2px 0 0; font-size:14px">{e.description}</p>
    <p class="cite-line"><span>Archived {longDate(e.archived)}.</span> <span><strong>How to cite:</strong> {cite}</span></p>
  </div>
  <div class="side">
    {authorHref && <a class="fmt" href={authorHref}>WORKS →</a>}
    <a class="fmt" href={e.url} rel="noopener" target="_blank" title={e.urlLabel || undefined}>{linkLabel || 'OPEN SOURCE ↗'}</a>
    <span class="muted" style="font-size:12px; width:100%">{e.source}</span>
  </div>
</article>
<style>
  .q-entry.q-target { outline: 2px solid var(--saffron); outline-offset: -2px; background: var(--saffron-tint); }
  .cite-line { margin: 6px 0 0; font-size: 13px; line-height: 1.55; color: var(--muted); max-width: 780px; overflow-wrap: anywhere; }
  .cite-line strong { font-weight: 600; color: var(--ink-2); }
</style>
