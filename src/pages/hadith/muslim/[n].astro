---
import Base from '../../../layouts/Base.astro';
import '../../../styles/hadith.css';
import { muslim, searchArabic, muslimUrl, MUSLIM_ARCHIVED as ARCHIVED, type Hadith } from '../../../lib/hadith';
import { longDate, SITE } from '../../../lib/quran';

export function getStaticPaths() {
  const { hadiths } = muslim();
  return hadiths.map((h, i) => ({ params: { n: h.n }, props: { i } }));
}
const { i } = Astro.props as { i: number };
const { hadiths, books, people } = muslim();
const h: Hadith = hadiths[i];
const prev = hadiths[i - 1], next = hadiths[i + 1];
const book = books.find((b) => b.k === h.book);
const yr = (y?: number) => (y == null ? '' : y < 0 ? `${-y} BH` : `d. ${y}`);
const person = (id: number) => people[String(id)] || { n: `Narrator #${id}`, h: 0 };
// each chain runs from Muslim's teacher back to the earliest narrator; show it from the Prophet ﷺ forward
const chains = h.chains.map((ch) => ({ ids: [...ch].reverse(), toProphet: person(ch[ch.length - 1]).g === 1 }));
const here = `${SITE}/hadith/muslim/${h.n}/`;
const cite = `Muslim, Ṣaḥīḥ Muslim, ḥadīth ${h.n}${book ? ` (Book ${book.k}, ${book.name}, no. ${h.inbook})` : ''}. English translation by Abdul Hamid Siddiqui. In Islamic Internet Archives, archived ${longDate(ARCHIVED)}. ${here}.`;
const title = `Ṣaḥīḥ Muslim ${h.n}`;
const lead = h.en.replace(/\s+/g, ' ').slice(0, 150);
---
<Base title={title} description={lead || `Ḥadīth ${h.n} of Ṣaḥīḥ Muslim in Arabic and English.`} current="hadith">
  <article class="hd" data-pagefind-body>
    <nav class="hd-crumb" aria-label="Breadcrumb" data-pagefind-ignore><a href="/hadith/">Hadith Hub</a> › <a href="/hadith/muslim/">Ṣaḥīḥ Muslim</a> › {book && <a href={`/hadith/muslim/book/${book.k}/`}>Book {book.k}: {book.name}</a>}</nav>
    <header class="hd-head">
      <span class="eyebrow" data-pagefind-filter="collection">Ṣaḥīḥ Muslim</span>
      <h1 data-pagefind-meta="title">{title}</h1>
      {book && <span class="book">Book {book.k}, <span data-pagefind-filter="book">{book.name}</span> · no. {h.inbook} in the book</span>}
    </header>

    {h.ar && <p class="hd-ar" lang="ar" dir="rtl">{h.ar}</p>}
    {h.ar && <p class="hd-plain" lang="ar" aria-hidden="true">{searchArabic(h.ar)}</p>}
    {h.en && <p class="hd-en">{h.en}</p>}
    {h.en && <p class="hd-credit" data-pagefind-ignore>English translation by Abdul Hamid Siddiqui.</p>}

    <section data-pagefind-ignore>
      <h2>{chains.length > 1 ? 'Chains of narrators' : 'Chain of narrators'}</h2>
      {chains.length === 0 && <p class="hd-note">The narrator dataset used here has no chain for this ḥadīth. The chain can be read at the start of the Arabic text.</p>}
      {chains.map((c, k) => (
        <>
          {chains.length > 1 && <p class="hd-note" style="margin-top:12px">Chain {k + 1}</p>}
          <ol class="hd-chain">
            {c.toProphet && <li><span class="pr">The Prophet ﷺ<small>d. 11</small></span></li>}
            {c.ids.map((id) => { const p = person(id); return <li><a href={`/hadith/muslim-narrators/#n${id}`}>{p.n}<small>{yr(p.d) || (p.g === 1 ? 'Companion' : '')}</small></a></li>; })}
            <li><a class="bk" href="/hadith/muslim-narrators/#n0">Muslim<small>d. 261</small></a></li>
          </ol>
        </>
      ))}
      <p class="hd-note" style="margin-top:10px">Each name opens that narrator in the <a href="/hadith/muslim-narrators/">tree of Muslim's narrators</a>. Chains come from an automatically matched dataset and may contain mistakes; where the ḥadīth has several chains, some may be incomplete.</p>
    </section>

    <div class="hd-links" data-pagefind-ignore>
      {h.chains.length > 0 && <a class="btn btn-outline" href={`/hadith/muslim-narrators/#h${h.n}`}>Show this chain in the tree</a>}
      <a class="btn btn-quiet" href={muslimUrl(h)} rel="noopener" target="_blank">Read on sunnah.com ↗</a>
      {book && <a class="btn btn-quiet" href={`/hadith/muslim/book/${book.k}/`}>All of Book {book.k}</a>}
      <a class="btn btn-quiet" href="/hadith/muslim/#search">Search Ṣaḥīḥ Muslim</a>
    </div>

    <nav class="hd-nav" aria-label="Neighbouring ḥadīth" data-pagefind-ignore>
      {prev ? <a href={`/hadith/muslim/${prev.n}/`}>← Ḥadīth {prev.n}</a> : <span></span>}
      {next ? <a href={`/hadith/muslim/${next.n}/`}>Ḥadīth {next.n} →</a> : <span></span>}
    </nav>
    <p class="hd-cite" data-pagefind-ignore><strong>Archived</strong> {longDate(ARCHIVED)}. <strong>How to cite:</strong> {cite} Arabic text and numbering as on sunnah.com, from the open hadith-api collection.</p>
  </article>
</Base>
